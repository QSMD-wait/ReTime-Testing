<Application x:Class="ReTime_Testing.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:ReTime_Testing"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:system="clr-namespace:System;assembly=mscorlib">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources/>
                <ui:XamlControlsResources/>
                <ResourceDictionary Source="pack://application:,,,/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- 覆盖主题默认的 Pivot 内容边距（12,0,12,0），使 TabControlPivotStyle 内容可到边到沿 -->
            <Thickness x:Key="PivotItemMargin">0</Thickness>
            <!-- 覆盖 iNKORE 默认的 AutoHideScrollBars=False，保持滚动条薄条样式 -->
            <system:Boolean x:Key="AutoHideScrollBars">True</system:Boolean>
            <!-- 补齐 iNKORE CheckBox 样式引用但主题未提供的边框描边键，
                 抑制运行时 "Resource not found; ResourceKey='CheckBoxBorderThemeThickness'" 警告。 -->
            <system:Double x:Key="CheckBoxBorderThemeThickness">1</system:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>