<Window x:Class="ReTime_Testing.Views.Testing.DebugTest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReTime_Testing.Views.Testing"
        xmlns:controls="clr-namespace:ReTime_Testing.Views.Controls"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        mc:Ignorable="d"
        Title="调试测试"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:TitleBar.Height="36"
        Width="800"
        Height="600"
        MinWidth="400"
        MinHeight="500">
    
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" ScrollViewer.PanningMode="VerticalOnly">
            <StackPanel Margin="32">
                <TextBlock Text="TimeTopDesktop 设置"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="0,0,0,24"/>

                <!-- 测试 SettingsCard 控件 -->
                <TextBlock Text="卡片化设计测试"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <controls:SettingsCard Icon="{x:Static ui:SegoeFluentIcons.Home}"
                                       Title="开机自启"
                                       Description="在系统启动时自动运行本应用"
                                       ControlContent="{x:Null}"
                                       Margin="0,0,0,8"/>

                <controls:SettingsCard Icon="{x:Static ui:SegoeFluentIcons.Bug}"
                                       Title="调试模式"
                                       Description="启用详细的调试日志输出"
                                       ControlContent="{x:Null}"
                                       Margin="0,0,0,8"/>

                <controls:SettingsCard Icon="{x:Static ui:SegoeFluentIcons.Cloud}"
                                       Title="云端校准"
                                       Description="自动从云端同步时间校准"
                                       ControlContent="{x:Null}"
                                       Margin="0,0,0,16"/>

                <!-- 状态切换 -->
                <TextBlock Text="状态控制"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>
                
                <!-- 状态切换按钮 -->
                <Button Content="Loading 状态"
                           Command="{Binding SetLoadingCommand}"
                           IsEnabled="{Binding IsStateControlsEnabled}"
                           Width="150"
                           Height="32"
                           Margin="0,0,0,8"/>
                
                <Button Content="Success 状态"
                           Command="{Binding SetSuccessCommand}"
                           IsEnabled="{Binding IsStateControlsEnabled}"
                           Width="150"
                           Height="32"
                           Margin="0,0,0,8"/>
                
                <Button Content="Error 状态"
                           Command="{Binding SetErrorCommand}"
                           IsEnabled="{Binding IsStateControlsEnabled}"
                           Width="150"
                           Height="32"
                           Margin="0,0,0,8"/>
                
                <Button Content="Paused 状态"
                           Command="{Binding SetPausedCommand}"
                           IsEnabled="{Binding IsStateControlsEnabled}"
                           Width="150"
                           Height="32"
                           Margin="0,0,0,8"/>
                
                <Button Content="Progress 状态 (50%)"
                           Command="{Binding SetProgressCommand}"
                           IsEnabled="{Binding IsStateControlsEnabled}"
                           Width="150"
                           Height="32"
                           Margin="0,0,0,24"/>
                
                <!-- 进度值控制 -->
                <TextBlock Text="进度值"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                    <Slider Value="{Binding ProgressValue}"
                            Minimum="0"
                            Maximum="100"
                            Width="300"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding ProgressValue, StringFormat={}{0:F0}%}"
                               Width="50"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- 时间控制 -->
                <TextBlock Text="时间控制"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>
                
                <TextBlock Text="设置开始和结束时间，进度条将按时间段前进"
                           FontSize="12"
                           Foreground="Gray"
                           Margin="0,0,0,8"/>
                
                <!-- 开始时间 -->
                <TextBlock Text="开始时间"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <ComboBox ItemsSource="{Binding Hours}"
                                SelectedItem="{Binding StartHour}"
                                Width="80"
                                HorizontalAlignment="Left"/>
                    <TextBlock Text="时"
                               VerticalAlignment="Center"
                               Margin="4,0,4,0"/>
                    <ComboBox ItemsSource="{Binding Minutes}"
                                SelectedItem="{Binding StartMinute}"
                                Width="80"
                                HorizontalAlignment="Left"/>
                    <TextBlock Text="分"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                </StackPanel>
                
                <!-- 结束时间 -->
                <TextBlock Text="结束时间"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <ComboBox ItemsSource="{Binding Hours}"
                                SelectedItem="{Binding EndHour}"
                                Width="80"
                                HorizontalAlignment="Left"/>
                    <TextBlock Text="时"
                               VerticalAlignment="Center"
                               Margin="4,0,4,0"/>
                    <ComboBox ItemsSource="{Binding Minutes}"
                                SelectedItem="{Binding EndMinute}"
                                Width="80"
                                HorizontalAlignment="Left"/>
                    <TextBlock Text="分"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                </StackPanel>
                
                <!-- 时间控制按钮 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="开始（已废弃）"
                               Command="{Binding StartScheduleCommand}"
                               Width="120"
                               Height="32"
                               Margin="0,0,8,0"
                               IsEnabled="False"
                               ToolTip="此功能已废弃，请使用 ScheduleManager"/>

                    <Button Content="停止（已废弃）"
                               Command="{Binding StopScheduleCommand}"
                               Width="120"
                               Height="32"
                               IsEnabled="False"
                               ToolTip="此功能已废弃，请使用 ScheduleManager"/>
                </StackPanel>

                <!-- 当前进度 -->
                <TextBlock Text="当前进度"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBlock Text="{Binding ScheduleProgress, StringFormat={}{0:F1}%}"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="Blue"
                           Margin="0,0,0,8"/>

                <TextBlock Text="{Binding ScheduleStatus}"
                           FontSize="12"
                           Foreground="Gray"
                           Margin="0,0,0,32"/>

                <!-- 互斥锁调试 -->
                <TextBlock Text="互斥锁调试"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <TextBlock Text="用于调试互斥锁功能，测试多实例检测"
                           FontSize="12"
                           Foreground="Gray"
                           Margin="0,0,0,8"/>

                <!-- 互斥锁状态信息 -->
                <Border Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="互斥锁状态信息"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="互斥锁状态:"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MutexStatus}"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMutexAcquired}" Value="True">
                                                <Setter Property="Foreground" Value="Green"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMutexAcquired}" Value="False">
                                                <Setter Property="Foreground" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="互斥锁 ID:"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MutexId}"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="是否启用:"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding IsMutexEnabled}"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="启用"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMutexEnabled}" Value="False">
                                                <Setter Property="Text" Value="禁用"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 互斥锁操作按钮 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="释放互斥锁"
                            Command="{Binding ReleaseMutexCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"
                            ToolTip="释放互斥锁，允许新实例启动"/>

                    <Button Content="重新获取"
                            Command="{Binding ReacquireMutexCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"
                            ToolTip="重新尝试获取互斥锁"/>

                    <Button Content="切换启用状态"
                            Command="{Binding ToggleMutexEnabledCommand}"
                            Width="120"
                            Height="32"
                            ToolTip="切换互斥锁的启用/禁用状态"/>
                </StackPanel>

                <TextBlock Text="提示：修改互斥锁状态后，请重新启动应用程序测试多实例功能"
                           FontSize="12"
                           Foreground="Orange"
                           TextWrapping="Wrap"
                           Margin="0,0,0,32"/>

                <!-- 进度条位置控制 -->
                <TextBlock Text="进度条位置控制"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <TextBlock Text="调整进度条在屏幕上的位置（上、下、左、右）"
                           FontSize="12"
                           Foreground="Gray"
                           Margin="0,0,0,8"/>

                <!-- 位置状态信息 -->
                <Border BorderBrush="Gray"
                        BorderThickness="1"
                        Background="#F5F5F5"
                        Padding="16"
                        Margin="0,0,0,16"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="当前位置状态:"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="当前位置: "
                                       Width="120"/>
                            <TextBlock Text="{Binding PositionText}"
                                       FontWeight="SemiBold"
                                       Foreground="Blue"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 位置切换按钮 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="顶部"
                            Command="{Binding SetPositionTopCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"
                            ToolTip="将进度条切换到顶部"/>

                    <Button Content="底部"
                            Command="{Binding SetPositionBottomCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"
                            ToolTip="将进度条切换到底部"/>

                    <Button Content="左侧"
                            Command="{Binding SetPositionLeftCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"
                            ToolTip="将进度条切换到左侧"/>

                    <Button Content="右侧"
                            Command="{Binding SetPositionRightCommand}"
                            Width="120"
                            Height="32"
                            ToolTip="将进度条切换到右侧"/>
                </StackPanel>

                <TextBlock Text="提示：切换位置会关闭当前窗口并创建新窗口"
                           FontSize="12"
                           Foreground="Orange"
                           TextWrapping="Wrap"
                           Margin="0,0,0,32"/>

                <!-- GlobalTimeTopDesktopService API 调试 -->
                <TextBlock Text="GlobalTimeTopDesktopService API 调试"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <TextBlock Text="测试进度条服务的所有公共 API"
                           FontSize="12"
                           Foreground="Gray"
                           Margin="0,0,0,8"/>

                <!-- 额外状态控制 -->
                <TextBlock Text="额外状态控制"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="Hidden 状态"
                            Command="{Binding SetHiddenCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="Disabled 状态"
                            Command="{Binding SetDisabledCommand}"
                            Width="120"
                            Height="32"/>
                </StackPanel>

                <!-- 可见性控制 -->
                <TextBlock Text="可见性控制"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="Visible"
                            Command="{Binding SetVisibilityVisibleCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="Hidden"
                            Command="{Binding SetVisibilityHiddenCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="Collapsed"
                            Command="{Binding SetVisibilityCollapsedCommand}"
                            Width="120"
                            Height="32"/>
                </StackPanel>

                <!-- 启用状态控制 -->
                <TextBlock Text="启用状态控制"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="Enabled"
                            Command="{Binding SetEnabledTrueCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="Disabled"
                            Command="{Binding SetEnabledFalseCommand}"
                            Width="120"
                            Height="32"/>
                </StackPanel>

                <!-- 透明度控制 -->
                <TextBlock Text="透明度控制"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="1.0 (100%)"
                            Command="{Binding SetOpacityFullCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="0.5 (50%)"
                            Command="{Binding SetOpacityHalfCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="0.2 (20%)"
                            Command="{Binding SetOpacityLowCommand}"
                            Width="120"
                            Height="32"/>
                </StackPanel>

                <!-- 前景色控制 -->
                <TextBlock Text="前景色控制"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="蓝色"
                            Command="{Binding SetForegroundBlueCommand}"
                            Width="100"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="绿色"
                            Command="{Binding SetForegroundGreenCommand}"
                            Width="100"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="红色"
                            Command="{Binding SetForegroundRedCommand}"
                            Width="100"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="橙色"
                            Command="{Binding SetForegroundOrangeCommand}"
                            Width="100"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="灰色"
                            Command="{Binding SetForegroundGrayCommand}"
                            Width="100"
                            Height="32"/>
                </StackPanel>

                <!-- 背景色控制 -->
                <TextBlock Text="背景色控制"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="透明"
                            Command="{Binding SetBackgroundTransparentCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="浅灰色"
                            Command="{Binding SetBackgroundLightGrayCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="白色"
                            Command="{Binding SetBackgroundWhiteCommand}"
                            Width="120"
                            Height="32"/>
                </StackPanel>

                <!-- 范围控制 -->
                <TextBlock Text="范围控制"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="0-100"
                            Command="{Binding SetRange0100Command}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="0-1"
                            Command="{Binding SetRange01Command}"
                            Width="120"
                            Height="32"/>
                </StackPanel>

                <!-- 其他操作 -->
                <TextBlock Text="其他操作"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="重置状态"
                            Command="{Binding ResetStateCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="批量更新测试"
                            Command="{Binding BatchUpdateTestCommand}"
                            Width="150"
                            Height="32"/>
                </StackPanel>

                <TextBlock Text="提示：批量更新测试会同时设置进度为 75%、前景色为绿色、透明度为 0.8、可见性为 Visible"
                           FontSize="12"
                           Foreground="Orange"
                           TextWrapping="Wrap"
                           Margin="0,0,0,32"/>

                <!-- 时间服务调试 -->
                <TextBlock Text="时间服务调试"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <TextBlock Text="测试绝对时间服务和云端校准功能"
                           FontSize="12"
                           Foreground="Gray"
                           Margin="0,0,0,8"/>

                <!-- 时间服务状态信息 -->
                <Border Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="时间服务状态"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="当前时间:"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentTime}"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="Blue"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="云端同步:"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding IsCloudSynchronized}"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCloudSynchronized}" Value="True">
                                                <Setter Property="Foreground" Value="Green"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCloudSynchronized}" Value="False">
                                                <Setter Property="Foreground" Value="Orange"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 时间服务操作按钮 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="手动校准 (+5秒)"
                            Command="{Binding CalibrateTimeForwardCommand}"
                            Width="140"
                            Height="32"
                            Margin="0,0,8,0"
                            ToolTip="手动校准时间向前5秒"/>

                    <Button Content="手动校准 (-5秒)"
                            Command="{Binding CalibrateTimeBackwardCommand}"
                            Width="140"
                            Height="32"
                            ToolTip="手动校准时间向后5秒"/>
                </StackPanel>

                <TextBlock Text="提示：手动校准用于测试时间跳跃处理功能"
                           FontSize="12"
                           Foreground="Orange"
                           TextWrapping="Wrap"
                           Margin="0,0,0,32"/>

                <!-- 执行计划调试 -->
                <TextBlock Text="执行计划调试"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <TextBlock Text="查看当前执行计划和时间段状态"
                           FontSize="12"
                           Foreground="Gray"
                           Margin="0,0,0,8"/>

                <!-- 执行计划状态信息 -->
                <Border Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="执行计划状态"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="当前时间段:"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentSegmentName}"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="当前状态:"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentState}"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="下个时间点:"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding NextTimePoint}"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="活跃状态:"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding IsActiveSegment}"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActiveSegment}" Value="True">
                                                <Setter Property="Foreground" Value="Green"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsActiveSegment}" Value="False">
                                                <Setter Property="Foreground" Value="Gray"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 执行计划操作按钮 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="显示执行计划"
                            Command="{Binding ShowExecutionPlanCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"
                            ToolTip="在日志中显示完整执行计划"/>

                    <Button Content="应用当前状态"
                            Command="{Binding ApplyCurrentStateCommand}"
                            Width="120"
                            Height="32"
                            ToolTip="重新应用当前状态"/>
                </StackPanel>

                <TextBlock Text="提示：执行计划详情会在日志窗口中显示"
                           FontSize="12"
                           Foreground="Orange"
                           TextWrapping="Wrap"
                           Margin="0,0,0,32"/>

                <!-- 调度管理器调试 -->
                <TextBlock Text="调度管理器调试"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <TextBlock Text="测试调度管理器的轮询和状态切换功能"
                           FontSize="12"
                           Foreground="Gray"
                           Margin="0,0,0,8"/>

                <!-- 调度管理器状态信息 -->
                <Border Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="调度管理器状态"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="调度运行中:"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding IsScheduleManagerRunning}"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScheduleManagerRunning}" Value="True">
                                                <Setter Property="Foreground" Value="Green"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsScheduleManagerRunning}" Value="False">
                                                <Setter Property="Foreground" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="轮询间隔:"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PollingInterval}"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="时间点数量:"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TimePointCount}"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 调度管理器操作按钮 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="停止调度"
                            Command="{Binding StopScheduleManagerCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"
                            ToolTip="停止调度管理器"/>

                    <Button Content="重启调度"
                            Command="{Binding RestartScheduleManagerCommand}"
                            Width="120"
                            Height="32"
                            ToolTip="重新启动调度管理器"/>
                </StackPanel>

                <TextBlock Text="提示：停止和重启调度会影响所有时间相关的功能"
                           FontSize="12"
                           Foreground="Orange"
                           TextWrapping="Wrap"
                           Margin="0,0,0,32"/>

                <!-- 云端校准服务调试 -->
                <TextBlock Text="云端校准服务调试"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <TextBlock Text="测试云端时间校准功能"
                           FontSize="12"
                           Foreground="Gray"
                           Margin="0,0,0,8"/>

                <!-- 云端校准服务状态信息 -->
                <Border Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="云端校准服务状态"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="校准服务运行中:"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding IsCloudCalibrationRunning}"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCloudCalibrationRunning}" Value="True">
                                                <Setter Property="Foreground" Value="Green"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCloudCalibrationRunning}" Value="False">
                                                <Setter Property="Foreground" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="失败次数:"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CalibrationFailureCount}"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Green"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CalibrationFailureCount}" Value="1">
                                                <Setter Property="Foreground" Value="Orange"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CalibrationFailureCount}" Value="2">
                                                <Setter Property="Foreground" Value="Orange"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CalibrationFailureCount}" Value="3">
                                                <Setter Property="Foreground" Value="Orange"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CalibrationFailureCount}" Value="4">
                                                <Setter Property="Foreground" Value="Orange"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CalibrationFailureCount}" Value="5">
                                                <Setter Property="Foreground" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="当前间隔:"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentCalibrationInterval}"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="上次校准时间:"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LastCalibrationTime}"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 云端校准服务操作按钮 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="手动触发校准"
                            Command="{Binding TriggerManualCalibrationCommand}"
                            Width="140"
                            Height="32"
                            Margin="0,0,8,0"
                            ToolTip="手动触发一次云端校准"/>

                    <Button Content="重置失败计数"
                            Command="{Binding ResetCalibrationFailuresCommand}"
                            Width="140"
                            Height="32"
                            ToolTip="重置校准失败计数器"/>
                </StackPanel>

                <TextBlock Text="提示：云端时间获取目前是模拟的，实际需要连接真实的时间服务"
                           FontSize="12"
                           Foreground="Orange"
                           TextWrapping="Wrap"
                           Margin="0,0,0,32"/>

                <!-- 样式优先级测试 -->
                <TextBlock Text="样式优先级测试"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <TextBlock Text="测试样式优先级：时间表 > 配置文件 > 默认值"
                           FontSize="12"
                           Foreground="Gray"
                           Margin="0,0,0,8"/>

                <!-- 样式测试按钮 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="默认样式"
                            Command="{Binding ApplyDefaultStyleCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"
                            ToolTip="应用默认样式"/>

                    <Button Content="配置文件样式"
                            Command="{Binding ApplyConfigStyleCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"
                            ToolTip="应用配置文件样式"/>

                    <Button Content="时间表样式"
                            Command="{Binding ApplyScheduleStyleCommand}"
                            Width="120"
                            Height="32"
                            ToolTip="应用时间表样式"/>
                </StackPanel>

                <TextBlock Text="提示：样式优先级测试用于验证样式覆盖逻辑"
                           FontSize="12"
                           Foreground="Orange"
                           TextWrapping="Wrap"
                           Margin="0,0,0,32"/>

                <!-- 综合测试 -->
                <TextBlock Text="综合测试"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <TextBlock Text="运行完整的端到端测试"
                           FontSize="12"
                           Foreground="Gray"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="运行综合测试"
                            Command="{Binding RunComprehensiveTestCommand}"
                            Width="150"
                            Height="32"
                            Margin="0,0,8,0"
                            ToolTip="运行完整的端到端测试"/>

                    <Button Content="查看测试报告"
                            Command="{Binding ShowTestReportCommand}"
                            Width="150"
                            Height="32"
                            ToolTip="显示测试结果报告"/>
                </StackPanel>

                <TextBlock Text="提示：综合测试会验证所有核心功能，结果会在日志窗口中显示"
                           FontSize="12"
                           Foreground="Orange"
                           TextWrapping="Wrap"
                           Margin="0,0,0,32"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</Window>