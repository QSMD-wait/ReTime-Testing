<UserControl x:Class="ReTime_Testing.Views.Testing.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="960"
             d:DesignHeight="600">
    <ScrollViewer VerticalScrollBarVisibility="Auto" ScrollViewer.PanningMode="VerticalOnly">
        <StackPanel Margin="24,24,24,24">

            <TextBlock Text="服务状态总览"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <TextBlock Text="实时展示核心服务的运行状态，每秒自动刷新"
                       FontSize="12"
                       Foreground="Gray"
                       Margin="0,4,0,24"/>

            <!-- 时间服务 -->
            <TextBlock Text="时间服务"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="当前时间" Foreground="Gray" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentTime}"
                           FontWeight="SemiBold"
                           Foreground="Blue"
                           VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="云端同步" Foreground="Gray" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="是"/>
                            <Setter Property="Foreground" Value="Green"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCloudSynchronized}" Value="False">
                                    <Setter Property="Text" Value="否"/>
                                    <Setter Property="Foreground" Value="Orange"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- 调度管理器 -->
            <TextBlock Text="调度管理器"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="调度运行中" Foreground="Gray" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="是"/>
                            <Setter Property="Foreground" Value="Green"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScheduleManagerRunning}" Value="False">
                                    <Setter Property="Text" Value="否"/>
                                    <Setter Property="Foreground" Value="Red"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="时间点数量" Foreground="Gray" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding TimePointCount}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="当前时间段" Foreground="Gray" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentSegmentName}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="当前状态" Foreground="Gray" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentState}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="活跃状态" Foreground="Gray" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="是"/>
                            <Setter Property="Foreground" Value="Green"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActiveSegment}" Value="False">
                                    <Setter Property="Text" Value="否"/>
                                    <Setter Property="Foreground" Value="Gray"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- 互斥锁与进度条 -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="互斥锁"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="状态" Foreground="Gray" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding MutexStatus}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMutexAcquired}" Value="True">
                                            <Setter Property="Foreground" Value="Green"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMutexAcquired}" Value="False">
                                            <Setter Property="Foreground" Value="Red"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="进度条"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="位置" Foreground="Gray" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding PositionText}"
                                   FontWeight="SemiBold"
                                   Foreground="Blue"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- 快捷操作 -->
            <TextBlock Text="快捷操作"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <TextBlock Text="常用的开发辅助操作"
                       FontSize="12"
                       Foreground="Gray"
                       Margin="0,4,0,16"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="打开数据目录"
                        Command="{Binding OpenDataDirectoryCommand}"
                        Width="140"
                        Height="32"
                        Margin="0,0,8,0"
                        ToolTip="打开应用数据目录（data/）"/>
                <Button Content="打开日志目录"
                        Command="{Binding OpenLogDirectoryCommand}"
                        Width="140"
                        Height="32"
                        Margin="0,0,8,0"
                        ToolTip="打开日志文件目录（data/Logs/）"/>
                <Button Content="重启应用"
                        Command="{Binding RestartApplicationCommand}"
                        Width="140"
                        Height="32"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTip="立即重启应用程序"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>