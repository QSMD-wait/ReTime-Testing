<UserControl x:Class="ReTime_Testing.Views.Testing.Pages.ErrorSimulatorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             mc:Ignorable="d"
             d:DesignWidth="960"
             d:DesignHeight="600">
    <ScrollViewer VerticalScrollBarVisibility="Auto" ScrollViewer.PanningMode="VerticalOnly">
        <StackPanel Margin="24,24,24,24">

            <!-- 标题 -->
            <TextBlock Text="错误模拟与崩溃窗口测试"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <TextBlock Text="模拟各种异常抛出场景，验证全局错误处理链与崩溃报告窗口"
                       FontSize="12"
                       Foreground="Gray"
                       Margin="0,4,0,16"/>

            <!-- 直接打开崩溃窗口 -->
            <TextBlock Text="崩溃窗口"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="Gray"
                       Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,24">
                <Button Content="直接打开崩溃窗口"
                        Command="{Binding OpenCrashWindowDirectlyCommand}"
                        Width="160" Height="32" Margin="0,0,8,8"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTip="不抛异常，直接显示崩溃窗口（可忽略模式）"/>
                <Button Content="终止性崩溃窗口"
                        Command="{Binding OpenCrashWindowTerminatingCommand}"
                        Width="160" Height="32" Margin="0,0,8,8"
                        ToolTip="显示崩溃窗口（终止性模式，不允许忽略）"/>
                <Button Content="仅保存日志"
                        Command="{Binding SaveCrashLogOnlyCommand}"
                        Width="120" Height="32" Margin="0,0,8,8"
                        ToolTip="将崩溃日志保存到文件，不打开窗口"/>
            </WrapPanel>

            <!-- UI 线程异常 -->
            <TextBlock Text="UI 线程异常（DispatcherUnhandledException）"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="Gray"
                       Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,24">
                <Button Content="NullReferenceException"
                        Command="{Binding ThrowNullReferenceCommand}"
                        Width="180" Height="32" Margin="0,0,8,8"
                        ToolTip="抛出空引用异常"/>
                <Button Content="InvalidOperationException"
                        Command="{Binding ThrowInvalidOperationCommand}"
                        Width="200" Height="32" Margin="0,0,8,8"
                        ToolTip="抛出操作无效异常"/>
                <Button Content="AggregateException"
                        Command="{Binding ThrowAggregateExceptionCommand}"
                        Width="180" Height="32" Margin="0,0,8,8"
                        ToolTip="抛出包含内部异常的聚合异常"/>
            </WrapPanel>

            <!-- 后台 Task 异常 -->
            <TextBlock Text="后台 Task 异常（TaskScheduler.UnobservedTaskException）"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="Gray"
                       Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,16">
                <Button Content="后台 Task 抛出异常"
                        Command="{Binding ThrowBackgroundTaskExceptionCommand}"
                        Width="160" Height="32" Margin="0,0,8,8"
                        ToolTip="在 Task.Run 中抛出未 await 的异常"/>
            </WrapPanel>

            <!-- 说明 -->
            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="4"
                    Padding="12,10"
                    Margin="0,8,0,0">
                <TextBlock TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run FontWeight="SemiBold" Text="异常捕获链路："/>
                    <LineBreak/>
                    <Run Text="DispatcherUnhandledException → UI 线程同步异常"/>
                    <LineBreak/>
                    <Run Text="TaskScheduler.UnobservedTaskException → 后台未观察异常"/>
                    <LineBreak/>
                    <Run Text="AppDomain.UnhandledException → CLR 级致命异常"/>
                    <LineBreak/>
                    <Run Text="每条路径均：记录日志 → 构建报告 → 保存 crash_*.log → 显示崩溃窗口"/>
                </TextBlock>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
