<UserControl x:Class="ReTime_Testing.Views.Testing.Pages.MainFeaturePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="960"
             d:DesignHeight="600">
    <ScrollViewer VerticalScrollBarVisibility="Auto" ScrollViewer.PanningMode="VerticalOnly">
        <StackPanel Margin="24,24,24,24">

            <!-- 状态控制 -->
            <TextBlock Text="状态控制"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <TextBlock Text="切换进度条的显示状态，滑块实时调整进度值"
                       FontSize="12"
                       Foreground="Gray"
                       Margin="0,4,0,16"/>

            <WrapPanel Margin="0,0,0,16">
                <Button Content="Loading 状态"
                        Command="{Binding SetLoadingCommand}"
                        Width="140" Height="32" Margin="0,0,8,8"/>
                <Button Content="Success 状态"
                        Command="{Binding SetSuccessCommand}"
                        Width="140" Height="32" Margin="0,0,8,8"/>
                <Button Content="Error 状态"
                        Command="{Binding SetErrorCommand}"
                        Width="140" Height="32" Margin="0,0,8,8"/>
                <Button Content="Paused 状态"
                        Command="{Binding SetPausedCommand}"
                        Width="140" Height="32" Margin="0,0,8,8"/>
                <Button Content="Progress 状态"
                        Command="{Binding SetProgressCommand}"
                        Width="140" Height="32" Margin="0,0,8,8"
                        ToolTip="使用当前进度值"/>
                <Button Content="Hidden 状态"
                        Command="{Binding SetHiddenCommand}"
                        Width="140" Height="32" Margin="0,0,8,8"/>
                <Button Content="Disabled 状态"
                        Command="{Binding SetDisabledCommand}"
                        Width="140" Height="32" Margin="0,0,8,8"/>
            </WrapPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                <Slider Value="{Binding ProgressValue}"
                        Minimum="0"
                        Maximum="100"
                        Width="480"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ProgressValue, StringFormat={}{0:F0}%}"
                           Width="50"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <!-- 样式控制 -->
            <TextBlock Text="样式控制"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <TextBlock Text="实时调整进度条的外观样式"
                       FontSize="12"
                       Foreground="Gray"
                       Margin="0,4,0,16"/>

            <TextBlock Text="可见性"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="Gray"
                       Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,20">
                <Button Content="Visible"
                        Command="{Binding SetVisibilityVisibleCommand}"
                        Width="120" Height="32" Margin="0,0,8,8"/>
                <Button Content="Hidden"
                        Command="{Binding SetVisibilityHiddenCommand}"
                        Width="120" Height="32" Margin="0,0,8,8"/>
                <Button Content="Collapsed"
                        Command="{Binding SetVisibilityCollapsedCommand}"
                        Width="120" Height="32" Margin="0,0,8,8"/>
            </WrapPanel>

            <TextBlock Text="启用状态"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="Gray"
                       Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,20">
                <Button Content="Enabled"
                        Command="{Binding SetEnabledTrueCommand}"
                        Width="120" Height="32" Margin="0,0,8,8"/>
                <Button Content="Disabled"
                        Command="{Binding SetEnabledFalseCommand}"
                        Width="120" Height="32" Margin="0,0,8,8"/>
            </WrapPanel>

            <TextBlock Text="透明度"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="Gray"
                       Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,20">
                <Button Content="1.0 (100%)"
                        Command="{Binding SetOpacityFullCommand}"
                        Width="120" Height="32" Margin="0,0,8,8"/>
                <Button Content="0.5 (50%)"
                        Command="{Binding SetOpacityHalfCommand}"
                        Width="120" Height="32" Margin="0,0,8,8"/>
                <Button Content="0.2 (20%)"
                        Command="{Binding SetOpacityLowCommand}"
                        Width="120" Height="32" Margin="0,0,8,8"/>
            </WrapPanel>

            <TextBlock Text="前景色"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="Gray"
                       Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,20">
                <Button Content="蓝色"
                        Command="{Binding SetForegroundBlueCommand}"
                        Width="100" Height="32" Margin="0,0,8,8"/>
                <Button Content="绿色"
                        Command="{Binding SetForegroundGreenCommand}"
                        Width="100" Height="32" Margin="0,0,8,8"/>
                <Button Content="红色"
                        Command="{Binding SetForegroundRedCommand}"
                        Width="100" Height="32" Margin="0,0,8,8"/>
                <Button Content="橙色"
                        Command="{Binding SetForegroundOrangeCommand}"
                        Width="100" Height="32" Margin="0,0,8,8"/>
                <Button Content="灰色"
                        Command="{Binding SetForegroundGrayCommand}"
                        Width="100" Height="32" Margin="0,0,8,8"/>
            </WrapPanel>

            <TextBlock Text="背景色"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="Gray"
                       Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,20">
                <Button Content="透明"
                        Command="{Binding SetBackgroundTransparentCommand}"
                        Width="120" Height="32" Margin="0,0,8,8"/>
                <Button Content="浅灰色"
                        Command="{Binding SetBackgroundLightGrayCommand}"
                        Width="120" Height="32" Margin="0,0,8,8"/>
                <Button Content="白色"
                        Command="{Binding SetBackgroundWhiteCommand}"
                        Width="120" Height="32" Margin="0,0,8,8"/>
            </WrapPanel>

            <TextBlock Text="进度范围"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="Gray"
                       Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,20">
                <Button Content="0-100"
                        Command="{Binding SetRange0100Command}"
                        Width="120" Height="32" Margin="0,0,8,8"/>
                <Button Content="0-1"
                        Command="{Binding SetRange01Command}"
                        Width="120" Height="32" Margin="0,0,8,8"/>
            </WrapPanel>

            <TextBlock Text="样式优先级"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="Gray"
                       Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,32">
                <Button Content="默认样式"
                        Command="{Binding ApplyDefaultStyleCommand}"
                        Width="120" Height="32" Margin="0,0,8,8"
                        ToolTip="样式优先级：时间表 &gt; 配置文件 &gt; 默认值"/>
                <Button Content="配置文件样式"
                        Command="{Binding ApplyConfigStyleCommand}"
                        Width="120" Height="32" Margin="0,0,8,8"
                        ToolTip="样式优先级：时间表 &gt; 配置文件 &gt; 默认值"/>
                <Button Content="时间表样式"
                        Command="{Binding ApplyScheduleStyleCommand}"
                        Width="120" Height="32" Margin="0,0,8,8"
                        ToolTip="样式优先级：时间表 &gt; 配置文件 &gt; 默认值"/>
            </WrapPanel>

            <!-- 其他操作 -->
            <TextBlock Text="其他操作"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <TextBlock Text="批量更新与恢复默认"
                       FontSize="12"
                       Foreground="Gray"
                       Margin="0,4,0,16"/>

            <WrapPanel>
                <Button Content="重置状态"
                        Command="{Binding ResetStateCommand}"
                        Width="140" Height="32" Margin="0,0,8,0"/>
                <Button Content="批量更新测试"
                        Command="{Binding BatchUpdateTestCommand}"
                        Width="140" Height="32"
                        ToolTip="同时设置进度 75%、前景色绿色、透明度 0.8、可见性 Visible"/>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>