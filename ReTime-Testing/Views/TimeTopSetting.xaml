<Window x:Class="ReTime_Testing.Views.TimeTopSetting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReTime_Testing.Views"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        mc:Ignorable="d"
        Title="设置"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:TitleBar.Height="36"
        Width="800"
        Height="600"
        MinWidth="400"
        MinHeight="500">
    
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32">
                <TextBlock Text="TimeTopDesktop 设置"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="0,0,0,24"/>

                <!-- 状态切换 -->
                <TextBlock Text="状态控制"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>
                
                <!-- 状态切换按钮 -->
                <Button Content="Loading 状态"
                           Command="{Binding SetLoadingCommand}"
                           IsEnabled="{Binding IsStateControlsEnabled}"
                           Width="150"
                           Height="32"
                           Margin="0,0,0,8"/>
                
                <Button Content="Success 状态"
                           Command="{Binding SetSuccessCommand}"
                           IsEnabled="{Binding IsStateControlsEnabled}"
                           Width="150"
                           Height="32"
                           Margin="0,0,0,8"/>
                
                <Button Content="Error 状态"
                           Command="{Binding SetErrorCommand}"
                           IsEnabled="{Binding IsStateControlsEnabled}"
                           Width="150"
                           Height="32"
                           Margin="0,0,0,8"/>
                
                <Button Content="Paused 状态"
                           Command="{Binding SetPausedCommand}"
                           IsEnabled="{Binding IsStateControlsEnabled}"
                           Width="150"
                           Height="32"
                           Margin="0,0,0,8"/>
                
                <Button Content="Progress 状态 (50%)"
                           Command="{Binding SetProgressCommand}"
                           IsEnabled="{Binding IsStateControlsEnabled}"
                           Width="150"
                           Height="32"
                           Margin="0,0,0,24"/>
                
                <!-- 进度值控制 -->
                <TextBlock Text="进度值"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                    <Slider Value="{Binding ProgressValue}"
                            Minimum="0"
                            Maximum="100"
                            Width="300"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding ProgressValue, StringFormat={}{0:F0}%}"
                               Width="50"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- 时间控制 -->
                <TextBlock Text="时间控制"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>
                
                <TextBlock Text="设置开始和结束时间，进度条将按时间段前进"
                           FontSize="12"
                           Foreground="Gray"
                           Margin="0,0,0,8"/>
                
                <!-- 开始时间 -->
                <TextBlock Text="开始时间"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <ComboBox ItemsSource="{Binding Hours}"
                                SelectedItem="{Binding StartHour}"
                                Width="80"
                                HorizontalAlignment="Left"/>
                    <TextBlock Text="时"
                               VerticalAlignment="Center"
                               Margin="4,0,4,0"/>
                    <ComboBox ItemsSource="{Binding Minutes}"
                                SelectedItem="{Binding StartMinute}"
                                Width="80"
                                HorizontalAlignment="Left"/>
                    <TextBlock Text="分"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                </StackPanel>
                
                <!-- 结束时间 -->
                <TextBlock Text="结束时间"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <ComboBox ItemsSource="{Binding Hours}"
                                SelectedItem="{Binding EndHour}"
                                Width="80"
                                HorizontalAlignment="Left"/>
                    <TextBlock Text="时"
                               VerticalAlignment="Center"
                               Margin="4,0,4,0"/>
                    <ComboBox ItemsSource="{Binding Minutes}"
                                SelectedItem="{Binding EndMinute}"
                                Width="80"
                                HorizontalAlignment="Left"/>
                    <TextBlock Text="分"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                </StackPanel>
                
                <!-- 时间控制按钮 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="开始"
                               Command="{Binding StartTimerCommand}"
                               Width="120"
                               Height="32"
                               Margin="0,0,8,0"/>
                    
                    <Button Content="停止"
                               Command="{Binding StopTimerCommand}"
                               Width="120"
                               Height="32"/>
                </StackPanel>
                
                <!-- 当前进度 -->
                <TextBlock Text="当前进度"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                
                <TextBlock Text="{Binding TimerProgress, StringFormat={}{0:F1}%}"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="Blue"
                           Margin="0,0,0,8"/>
                
                <TextBlock Text="{Binding TimerStatus}"
                           FontSize="12"
                           Foreground="Gray"
                           Margin="0,0,0,32"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    
</Window>