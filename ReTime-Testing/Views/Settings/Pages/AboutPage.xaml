<pages:SettingsPageBase x:Class="ReTime_Testing.Views.Settings.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:pages="clr-namespace:ReTime_Testing.Views.Settings.Pages"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600">

    <ikw:SimpleStackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="4">

        <TextBlock Text="关于" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <!-- 卡片1：应用信息 -->
        <ui:SettingsExpander Header="ReTime - Testing"
                             Description="隐式时间进度条小工具">
            <ui:SettingsExpander.HeaderIcon>
                <Image Source="pack://application:,,,/ReTime-Testing;component/Resources/app.ico"
                       Width="32" Height="32"/>
            </ui:SettingsExpander.HeaderIcon>
            <TextBlock Text="{Binding AppVersion}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <ui:SettingsExpander.Items>
                <ui:SettingsCard Header="Copyright © 2025-2026 青色漫地_wait"
                                 Description="许可证协议：GNU General Public License v3.0">
                </ui:SettingsCard>
            </ui:SettingsExpander.Items>
        </ui:SettingsExpander>

        <!-- 卡片2：项目仓库 -->
        <ui:SettingsCard Header="Github 项目仓库"
                         Description="查看源码、反馈问题或参与开发">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.OpenFolder_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ui:HyperlinkButton Content="点击前往"
                                Click="OnOpenRepositoryClick"/>
        </ui:SettingsCard>

    </ikw:SimpleStackPanel>
</pages:SettingsPageBase>