<pages:SettingsPageBase x:Class="ReTime_Testing.Views.Settings.Pages.TextOverlayLayoutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:pages="clr-namespace:ReTime_Testing.Views.Settings.Pages"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:vm="clr-namespace:ReTime_Testing.ViewModels"
             xmlns:helpers="clr-namespace:ReTime_Testing.Helpers"
             xmlns:dd="urn:gong-wpf-dragdrop"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="700">

    <FrameworkElement.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <helpers:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <sys:Double x:Key="SettingsCardSpacing" xmlns:sys="clr-namespace:System;assembly=mscorlib">4</sys:Double>

        <!-- 插槽 ListViewItem 容器样式：水平排列 + 紧凑间距 -->
        <Style x:Key="SlotListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Setter Property="Padding" Value="2,2"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>

        <!-- 组件库 ListViewItem 容器样式：WrapPanel 固定尺寸 -->
        <Style x:Key="ComponentListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="76"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <!-- 分类筛选 RadioButton 样式 -->
        <Style x:Key="CategoryRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 插槽项模板：图标 + 名称 + 删除按钮 -->
        <DataTemplate x:Key="SlotItemTemplate" DataType="{x:Type vm:TextSlotItemViewModel}">
            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="6,2">
                <ui:FontIcon Icon="{Binding IconGlyph}" FontSize="18" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DisplayName}" FontSize="14" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                <Button FontSize="12" Padding="6" MinWidth="0" MinHeight="0"
                        VerticalAlignment="Center"
                        Command="{Binding DataContext.DeleteSlotCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:TextOverlayLayoutPage}}}"
                        CommandParameter="{Binding}"
                        ToolTip="移除插槽" Background="Transparent" BorderThickness="0"
                        Cursor="Hand">
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Delete_24_Regular}" FontSize="14"/>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </ikw:SimpleStackPanel>
        </DataTemplate>

    </FrameworkElement.Resources>

    <Grid Margin="12,6,12,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="组件配置" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,2"/>

        <!-- 插槽组行 -->
        <ikw:SimpleStackPanel Grid.Row="1" Spacing="2" Margin="0,0,0,1">

            <!-- 左组行 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="6" Padding="10,5" Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.AlignLeft_24_Regular}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="左组" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    </ikw:SimpleStackPanel>
                    <ListView Grid.Column="1" ItemsSource="{Binding LeftSlots}"
                              SelectedItem="{Binding SelectedLeftSlot, Mode=TwoWay}"
                              SelectionMode="Single" Background="Transparent" BorderThickness="0" Padding="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ItemContainerStyle="{StaticResource SlotListViewItemStyle}"
                              ItemTemplate="{StaticResource SlotItemTemplate}"
                              dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True"
                              dd:DragDrop.DropHandler="{Binding}"
                              dd:DragDrop.UseDefaultDragAdorner="True" dd:DragDrop.DefaultDragAdornerOpacity="0.7">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                </Grid>
            </Border>

            <!-- 中组行 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="6" Padding="10,5" Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.AlignCenterHorizontal_24_Regular}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="中组" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    </ikw:SimpleStackPanel>
                    <ListView Grid.Column="1" ItemsSource="{Binding CenterSlots}"
                              SelectedItem="{Binding SelectedCenterSlot, Mode=TwoWay}"
                              SelectionMode="Single" Background="Transparent" BorderThickness="0" Padding="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ItemContainerStyle="{StaticResource SlotListViewItemStyle}"
                              ItemTemplate="{StaticResource SlotItemTemplate}"
                              dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True"
                              dd:DragDrop.DropHandler="{Binding}"
                              dd:DragDrop.UseDefaultDragAdorner="True" dd:DragDrop.DefaultDragAdornerOpacity="0.7">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                </Grid>
            </Border>

            <!-- 右组行 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="6" Padding="10,5" Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.AlignRight_24_Regular}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="右组" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    </ikw:SimpleStackPanel>
                    <ListView Grid.Column="1" ItemsSource="{Binding RightSlots}"
                              SelectedItem="{Binding SelectedRightSlot, Mode=TwoWay}"
                              SelectionMode="Single" Background="Transparent" BorderThickness="0" Padding="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ItemContainerStyle="{StaticResource SlotListViewItemStyle}"
                              ItemTemplate="{StaticResource SlotItemTemplate}"
                              dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True"
                              dd:DragDrop.DropHandler="{Binding}"
                              dd:DragDrop.UseDefaultDragAdorner="True" dd:DragDrop.DefaultDragAdornerOpacity="0.7">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                </Grid>
            </Border>

        </ikw:SimpleStackPanel>

        <!-- 分隔线 -->
        <Separator Grid.Row="2" Margin="0,1"/>

        <!-- Pivot 风格 TabControl -->
        <TabControl Grid.Row="3"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    Style="{StaticResource TabControlPivotStyle}"
                    Margin="0,1,0,0">

            <!-- ==================== Tab 1: 组件库 ==================== -->
            <TabItem Header="组件库">
                <DockPanel LastChildFill="True">
                    <!-- 搜索栏 + 分类筛选 -->
                    <DockPanel DockPanel.Dock="Top" Margin="4,2,4,1">
                        <TextBox DockPanel.Dock="Left" Width="160" Height="26"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ui:ControlHelper.PlaceholderText="搜索组件..."
                                 VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="全部" Style="{StaticResource CategoryRadioButtonStyle}"
                                         GroupName="CategoryFilter" IsChecked="True" Checked="OnCategoryChecked"/>
                            <RadioButton Content="文本类" Style="{StaticResource CategoryRadioButtonStyle}"
                                         GroupName="CategoryFilter" Checked="OnCategoryChecked"/>
                            <RadioButton Content="时间类" Style="{StaticResource CategoryRadioButtonStyle}"
                                         GroupName="CategoryFilter" Checked="OnCategoryChecked"/>
                            <RadioButton Content="日期类" Style="{StaticResource CategoryRadioButtonStyle}"
                                         GroupName="CategoryFilter" Checked="OnCategoryChecked"/>
                            <RadioButton Content="进度类" Style="{StaticResource CategoryRadioButtonStyle}"
                                         GroupName="CategoryFilter" Checked="OnCategoryChecked"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- 网格布局：WrapPanel -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,1">
                        <ListView ItemsSource="{Binding FilteredComponents}"
                                  Background="Transparent" BorderThickness="0" Padding="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ItemContainerStyle="{StaticResource ComponentListViewItemStyle}"
                                  dd:DragDrop.IsDragSource="True"
                                  dd:DragDrop.UseDefaultDragAdorner="True"
                                  dd:DragDrop.DefaultDragAdornerOpacity="0.7">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ComponentLibraryItem}">
                                    <Grid Margin="10,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:FontIcon Grid.Column="0" Icon="{Binding IconGlyph}" FontSize="24"
                                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ikw:SimpleStackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       FontSize="10" TextWrapping="Wrap" Height="28"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </ikw:SimpleStackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ==================== Tab 2: 插槽设置 ==================== -->
            <TabItem Header="插槽设置"
                     Visibility="{Binding SelectedSlot, Converter={StaticResource NotNullToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <Grid>
                        <ContentControl Content="{Binding SelectedSlot}" Margin="0,4,0,0">
                            <ContentControl.ContentTemplate>
                                <DataTemplate DataType="{x:Type vm:TextSlotItemViewModel}">
                                    <ikw:SimpleStackPanel Spacing="{StaticResource SettingsCardSpacing}">

                                        <!-- ====== 数据源设置 ====== -->
                                        <ui:SettingsExpander Header="数据源设置"
                                                             Description="选择和配置该插槽显示的内容来源"
                                                             IsExpanded="True">
                                            <ui:SettingsExpander.HeaderIcon>
                                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Database_24_Regular}"/>
                                            </ui:SettingsExpander.HeaderIcon>
                                            <ComboBox ItemsSource="{Binding DataContext.SourceTypeOptions, RelativeSource={RelativeSource AncestorType={x:Type pages:TextOverlayLayoutPage}}}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="SourceType"
                                                      SelectedValue="{Binding CurrentSourceType, Mode=TwoWay}"
                                                      MinWidth="140"/>
                                            <ui:SettingsExpander.Items>
                                                <ui:SettingsCard Header="自定义文本"
                                                                 Description="数据源为「自定义文本」时显示的内容">
                                                    <TextBox Text="{Binding CustomText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             MinWidth="180"/>
                                                    <ui:SettingsCard.Visibility>
                                                        <Binding Path="IsCustomTextRelevant" Converter="{StaticResource BoolToVisibilityConverter}"/>
                                                    </ui:SettingsCard.Visibility>
                                                </ui:SettingsCard>

                                                <ui:SettingsCard Header="格式预设"
                                                                 Description="选择常用格式">
                                                    <ComboBox ItemsSource="{Binding FormatPresets}"
                                                              DisplayMemberPath="Label"
                                                              SelectedValuePath="Format"
                                                              SelectedValue="{Binding Format, Mode=TwoWay}"
                                                              MinWidth="140"/>
                                                    <ui:SettingsCard.Visibility>
                                                        <Binding Path="IsFormatRelevant" Converter="{StaticResource BoolToVisibilityConverter}"/>
                                                    </ui:SettingsCard.Visibility>
                                                </ui:SettingsCard>

                                                <ui:SettingsCard Header="显示秒数"
                                                                 Description="剩余时间/已过时间是否显示秒数">
                                                    <ui:ToggleSwitch IsOn="{Binding ShowSeconds, Mode=TwoWay}"
                                                                     OffContent="否" OnContent="是" MinWidth="0"/>
                                                    <ui:SettingsCard.Visibility>
                                                        <Binding Path="IsShowSecondsRelevant" Converter="{StaticResource BoolToVisibilityConverter}"/>
                                                    </ui:SettingsCard.Visibility>
                                                </ui:SettingsCard>

                                                <ui:SettingsCard Header="小数位数"
                                                                 Description="进度百分比的小数位数">
                                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Slider Value="{Binding DecimalPlaces, Mode=TwoWay}"
                                                                Minimum="0" Maximum="3" TickFrequency="1"
                                                                IsSnapToTickEnabled="True" Width="120"/>
                                                        <TextBlock Text="{Binding DecimalPlaces}" VerticalAlignment="Center"
                                                                   MinWidth="16" TextAlignment="Center"/>
                                                    </ikw:SimpleStackPanel>
                                                    <ui:SettingsCard.Visibility>
                                                        <Binding Path="IsDecimalPlacesRelevant" Converter="{StaticResource BoolToVisibilityConverter}"/>
                                                    </ui:SettingsCard.Visibility>
                                                </ui:SettingsCard>

                                                <ui:SettingsCard Header="回退文本"
                                                                 Description="当前段名/下一段名无数据时的回退文本">
                                                    <TextBox Text="{Binding Fallback, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             MinWidth="180"/>
                                                    <ui:SettingsCard.Visibility>
                                                        <Binding Path="IsFallbackRelevant" Converter="{StaticResource BoolToVisibilityConverter}"/>
                                                    </ui:SettingsCard.Visibility>
                                                </ui:SettingsCard>

                                                <ui:SettingsCard Header="同时显示时间"
                                                                 Description="下一段名同时显示开始时间">
                                                    <ui:ToggleSwitch IsOn="{Binding ShowTime, Mode=TwoWay}"
                                                                     OffContent="否" OnContent="是" MinWidth="0"/>
                                                    <ui:SettingsCard.Visibility>
                                                        <Binding Path="IsShowTimeRelevant" Converter="{StaticResource BoolToVisibilityConverter}"/>
                                                    </ui:SettingsCard.Visibility>
                                                </ui:SettingsCard>
                                            </ui:SettingsExpander.Items>
                                        </ui:SettingsExpander>

                                        <!-- ====== 通用设置 ====== -->
                                        <ui:SettingsExpander Header="通用设置"
                                                             Description="可见性、前后缀、字体和颜色覆盖"
                                                             IsExpanded="True">
                                            <ui:SettingsExpander.HeaderIcon>
                                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Settings_24_Regular}"/>
                                            </ui:SettingsExpander.HeaderIcon>
                                            <ui:SettingsExpander.Items>
                                                <ui:SettingsCard Header="可见"
                                                                 Description="临时隐藏而不删除">
                                                    <ui:ToggleSwitch IsOn="{Binding Visible, Mode=TwoWay}"
                                                                     OffContent="隐藏" OnContent="显示" MinWidth="0"/>
                                                </ui:SettingsCard>

                                                <ui:SettingsCard Header="前缀"
                                                                 Description="显示在内容之前的文本">
                                                    <TextBox Text="{Binding Prefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             MinWidth="100"/>
                                                </ui:SettingsCard>

                                                <ui:SettingsCard Header="后缀"
                                                                 Description="显示在内容之后的文本">
                                                    <TextBox Text="{Binding Suffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             MinWidth="100"/>
                                                </ui:SettingsCard>

                                                <ui:SettingsCard Header="字体覆盖"
                                                                 Description="留空使用全局字体">
                                                    <ComboBox ItemsSource="{Binding Fonts, RelativeSource={RelativeSource AncestorType={x:Type pages:TextOverlayLayoutPage}}}"
                                                              DisplayMemberPath="Display"
                                                              SelectedValuePath="Name"
                                                              SelectedValue="{Binding FontFamily, Mode=TwoWay}"
                                                              Loaded="FontCombo_Loaded"
                                                              MinWidth="160"/>
                                                </ui:SettingsCard>

                                                <ui:SettingsCard Header="字体大小覆盖"
                                                                 Description="留空使用全局字体大小">
                                                    <ui:NumberBox Value="{Binding FontSizeOverrideValue, Mode=TwoWay}"
                                                                  SpinButtonPlacementMode="Compact"
                                                                  Minimum="0" Maximum="48"
                                                                  SmallChange="1" LargeChange="2" MinWidth="90"/>
                                                </ui:SettingsCard>

                                                <ui:SettingsCard Header="颜色覆盖"
                                                                 Description="ARGB 十六进制，留空使用全局颜色">
                                                    <TextBox Text="{Binding ColorOverride, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             MinWidth="100"/>
                                                </ui:SettingsCard>
                                            </ui:SettingsExpander.Items>
                                        </ui:SettingsExpander>

                                        <!-- ====== 排序与删除 ====== -->
                                        <ui:SettingsExpander Header="排序与删除"
                                                             Description="调整排列顺序或移除此插槽">
                                            <ui:SettingsExpander.HeaderIcon>
                                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ArrowSort_24_Regular}"/>
                                            </ui:SettingsExpander.HeaderIcon>
                                            <ui:SettingsExpander.Items>
                                                <ui:SettingsCard Header="移动位置"
                                                                 Description="调整该插槽在组内的排列顺序">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Command="{Binding DataContext.MoveSlotUpCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:TextOverlayLayoutPage}}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="6,2" Margin="0,0,6,0">
                                                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="4">
                                                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ChevronUp_24_Regular}" FontSize="10"/>
                                                                <TextBlock Text="上移" FontSize="11"/>
                                                            </ikw:SimpleStackPanel>
                                                        </Button>
                                                        <Button Command="{Binding DataContext.MoveSlotDownCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:TextOverlayLayoutPage}}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="6,2">
                                                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="4">
                                                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ChevronDown_24_Regular}" FontSize="10"/>
                                                                <TextBlock Text="下移" FontSize="11"/>
                                                            </ikw:SimpleStackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </ui:SettingsCard>

                                                <ui:SettingsCard Header="删除插槽"
                                                                 Description="从组中移除此插槽">
                                                    <Button Command="{Binding DataContext.RemoveSelectedSlotCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:TextOverlayLayoutPage}}}"
                                                            Padding="8,2">
                                                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="4">
                                                            <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Delete_24_Regular}" FontSize="10"/>
                                                            <TextBlock Text="删除" FontSize="11"/>
                                                        </ikw:SimpleStackPanel>
                                                    </Button>
                                                </ui:SettingsCard>
                                            </ui:SettingsExpander.Items>
                                        </ui:SettingsExpander>

                                    </ikw:SimpleStackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== Tab 3: 组设置 ==================== -->
            <TabItem Header="组设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <ikw:SimpleStackPanel Spacing="{StaticResource SettingsCardSpacing}" Margin="0,4,0,0">
                    </ikw:SimpleStackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

    </Grid>
</pages:SettingsPageBase>