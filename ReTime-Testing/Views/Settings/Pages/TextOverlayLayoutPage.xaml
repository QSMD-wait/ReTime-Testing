<pages:SettingsPageBase x:Class="ReTime_Testing.Views.Settings.Pages.TextOverlayLayoutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:pages="clr-namespace:ReTime_Testing.Views.Settings.Pages"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:vm="clr-namespace:ReTime_Testing.ViewModels"
             xmlns:helpers="clr-namespace:ReTime_Testing.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="700">

    <FrameworkElement.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <helpers:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <sys:Double x:Key="SettingsCardSpacing" xmlns:sys="clr-namespace:System;assembly=mscorlib">4</sys:Double>

        <!-- 插槽 ListBoxItem 样式：卡片风格 + 选中高亮 + 悬停效果 -->
        <Style x:Key="SlotListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="6,3"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ui:FontIcon Grid.Column="0"
                                             Icon="{Binding IconGlyph}"
                                             FontSize="12"
                                             Margin="0,0,4,0"
                                             VerticalAlignment="Center"
                                             x:Name="SlotIcon"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayName}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>

                                <Button Grid.Column="2"
                                        x:Name="DeleteButton"
                                        FontSize="10"
                                        Padding="2"
                                        MinWidth="0" MinHeight="0"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"
                                        Click="OnSlotDeleteClick"
                                        ToolTip="移除插槽"
                                        Background="Transparent"
                                        BorderThickness="0">
                                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Dismiss_12_Regular}" FontSize="10"/>
                                </Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}"/>
                                <Setter TargetName="SlotIcon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="DeleteButton" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 组行内水平 ListBox 样式 -->
        <Style x:Key="HorizontalSlotListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SlotListBoxItemStyle}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分类筛选 RadioButton 样式 -->
        <Style x:Key="CategoryRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 添加按钮样式（圆形图标按钮） -->
        <Style x:Key="AddSlotButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="添加插槽"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ui:FontIcon x:Name="AddIcon"
                                         Icon="{x:Static ui:FluentSystemIcons.Add_24_Regular}"
                                         FontSize="14"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
                                <Setter TargetName="AddIcon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </FrameworkElement.Resources>

    <Grid Margin="12,8,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="插槽布局" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,4"/>

        <!-- 插槽组行 -->
        <ikw:SimpleStackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,2">

            <!-- 左组行 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="6" Padding="10,6" Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.AlignLeft_24_Regular}"
                                     FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="左组" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    </ikw:SimpleStackPanel>

                    <ListBox Grid.Column="1" ItemsSource="{Binding LeftSlots}"
                             SelectedItem="{Binding SelectedSlot, Mode=TwoWay}"
                             Style="{StaticResource HorizontalSlotListBoxStyle}"
                             SelectionChanged="OnSlotSelectionChanged"
                             Tag="0"/>

                    <Button Grid.Column="2" Style="{StaticResource AddSlotButtonStyle}" Click="OnAddLeftSlot"/>
                </Grid>
            </Border>

            <!-- 中组行 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="6" Padding="10,6" Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.AlignCenterHorizontal_24_Regular}"
                                     FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="中组" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    </ikw:SimpleStackPanel>

                    <ListBox Grid.Column="1" ItemsSource="{Binding CenterSlots}"
                             SelectedItem="{Binding SelectedSlot, Mode=TwoWay}"
                             Style="{StaticResource HorizontalSlotListBoxStyle}"
                             SelectionChanged="OnSlotSelectionChanged"
                             Tag="1"/>

                    <Button Grid.Column="2" Style="{StaticResource AddSlotButtonStyle}" Click="OnAddCenterSlot"/>
                </Grid>
            </Border>

            <!-- 右组行 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="6" Padding="10,6" Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.AlignRight_24_Regular}"
                                     FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="右组" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    </ikw:SimpleStackPanel>

                    <ListBox Grid.Column="1" ItemsSource="{Binding RightSlots}"
                             SelectedItem="{Binding SelectedSlot, Mode=TwoWay}"
                             Style="{StaticResource HorizontalSlotListBoxStyle}"
                             SelectionChanged="OnSlotSelectionChanged"
                             Tag="2"/>

                    <Button Grid.Column="2" Style="{StaticResource AddSlotButtonStyle}" Click="OnAddRightSlot"/>
                </Grid>
            </Border>

        </ikw:SimpleStackPanel>

        <!-- 分隔线 -->
        <Separator Grid.Row="2" Margin="0,2"/>

        <!-- Pivot 风格 TabControl -->
        <TabControl Grid.Row="3"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    Style="{StaticResource TabControlPivotStyle}"
                    Margin="0,2,0,0">

            <!-- ==================== Tab 1: 组件库 ==================== -->
            <TabItem Header="组件库">
                <DockPanel LastChildFill="True">
                    <!-- 搜索栏 + 分类筛选 -->
                    <DockPanel DockPanel.Dock="Top" Margin="4,4,4,2">
                        <TextBox DockPanel.Dock="Left" Width="160" Height="28"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ui:ControlHelper.PlaceholderText="搜索组件..."
                                 VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel Orientation="Horizontal" x:Name="CategoryPanel">
                            <RadioButton Content="全部" Style="{StaticResource CategoryRadioButtonStyle}"
                                         GroupName="CategoryFilter" IsChecked="True" Checked="OnCategoryChecked"/>
                            <RadioButton Content="文本类" Style="{StaticResource CategoryRadioButtonStyle}"
                                         GroupName="CategoryFilter" Checked="OnCategoryChecked"/>
                            <RadioButton Content="时间类" Style="{StaticResource CategoryRadioButtonStyle}"
                                         GroupName="CategoryFilter" Checked="OnCategoryChecked"/>
                            <RadioButton Content="日期类" Style="{StaticResource CategoryRadioButtonStyle}"
                                         GroupName="CategoryFilter" Checked="OnCategoryChecked"/>
                            <RadioButton Content="进度类" Style="{StaticResource CategoryRadioButtonStyle}"
                                         GroupName="CategoryFilter" Checked="OnCategoryChecked"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- 网格布局：WrapPanel -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,2">
                        <ItemsControl ItemsSource="{Binding FilteredComponents}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ComponentLibraryItem}">
                                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            CornerRadius="6" Padding="10,8" Margin="3"
                                            Cursor="Hand" MouseLeftButtonDown="OnComponentClick"
                                            BorderThickness="1" BorderBrush="Transparent"
                                            Width="180">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ikw:SimpleStackPanel Spacing="4">
                                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                                                <ui:FontIcon Icon="{Binding IconGlyph}" FontSize="18"
                                                             Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                                           VerticalAlignment="Center"/>
                                            </ikw:SimpleStackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       FontSize="10" TextWrapping="Wrap" MaxHeight="32"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </ikw:SimpleStackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ==================== Tab 2: 插槽设置 ==================== -->
            <TabItem Header="插槽设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <Grid>
                        <!-- 未选中插槽时的提示 -->
                        <TextBlock x:Name="HintText"
                                   Text="请在上方插槽组中点击一个插槽进行编辑"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="12" Margin="0,30,0,0"/>

                        <!-- 选中插槽后的编辑面板 -->
                        <ContentControl x:Name="SlotEditor" Content="{Binding SelectedSlot}" Margin="0,4,0,0">
                            <ContentControl.ContentTemplate>
                                <DataTemplate DataType="{x:Type vm:TextSlotItemViewModel}">
                                    <ikw:SimpleStackPanel Spacing="{StaticResource SettingsCardSpacing}">

                                        <!-- ====== 数据源设置 ====== -->
                                        <ui:SettingsExpander Header="数据源设置"
                                                             Description="选择和配置该插槽显示的内容来源"
                                                             IsExpanded="True">
                                            <ui:SettingsExpander.HeaderIcon>
                                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Database_24_Regular}"/>
                                            </ui:SettingsExpander.HeaderIcon>
                                            <ComboBox SelectedIndex="{Binding SourceTypeIndex, Mode=TwoWay}" MinWidth="140">
                                                <ComboBoxItem Content="不显示"/>
                                                <ComboBoxItem Content="自定义文本"/>
                                                <ComboBoxItem Content="当前段名"/>
                                                <ComboBoxItem Content="剩余时间"/>
                                                <ComboBoxItem Content="已过时间"/>
                                                <ComboBoxItem Content="进度百分比"/>
                                                <ComboBoxItem Content="系统时间"/>
                                                <ComboBoxItem Content="下一段名"/>
                                                <ComboBoxItem Content="当前日期"/>
                                                <ComboBoxItem Content="星期几"/>
                                            </ComboBox>
                                            <ui:SettingsExpander.Items>
                                                <ui:SettingsCard Header="自定义文本"
                                                                 Description="数据源为「自定义文本」时显示的内容">
                                                    <TextBox Text="{Binding CustomText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             MinWidth="180"/>
                                                    <ui:SettingsCard.Visibility>
                                                        <Binding Path="IsCustomTextRelevant" Converter="{StaticResource BoolToVisibilityConverter}"/>
                                                    </ui:SettingsCard.Visibility>
                                                </ui:SettingsCard>

                                                <ui:SettingsCard Header="格式字符串"
                                                                 Description="系统时间/日期/星期几的格式">
                                                    <TextBox Text="{Binding Format, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             MinWidth="180"/>
                                                    <ui:SettingsCard.Visibility>
                                                        <Binding Path="IsFormatRelevant" Converter="{StaticResource BoolToVisibilityConverter}"/>
                                                    </ui:SettingsCard.Visibility>
                                                </ui:SettingsCard>

                                                <ui:SettingsCard Header="显示秒数"
                                                                 Description="剩余时间/已过时间是否显示秒数">
                                                    <ui:ToggleSwitch IsOn="{Binding ShowSeconds, Mode=TwoWay}"
                                                                     OffContent="否" OnContent="是" MinWidth="0"/>
                                                    <ui:SettingsCard.Visibility>
                                                        <Binding Path="IsShowSecondsRelevant" Converter="{StaticResource BoolToVisibilityConverter}"/>
                                                    </ui:SettingsCard.Visibility>
                                                </ui:SettingsCard>

                                                <ui:SettingsCard Header="小数位数"
                                                                 Description="进度百分比的小数位数">
                                                    <ui:NumberBox Value="{Binding DecimalPlaces, Mode=TwoWay}"
                                                                  SpinButtonPlacementMode="Compact"
                                                                  Minimum="0" Maximum="4" SmallChange="1" MinWidth="90"/>
                                                    <ui:SettingsCard.Visibility>
                                                        <Binding Path="IsDecimalPlacesRelevant" Converter="{StaticResource BoolToVisibilityConverter}"/>
                                                    </ui:SettingsCard.Visibility>
                                                </ui:SettingsCard>

                                                <ui:SettingsCard Header="回退文本"
                                                                 Description="当前段名/下一段名无数据时的回退文本">
                                                    <TextBox Text="{Binding Fallback, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             MinWidth="180"/>
                                                    <ui:SettingsCard.Visibility>
                                                        <Binding Path="IsFallbackRelevant" Converter="{StaticResource BoolToVisibilityConverter}"/>
                                                    </ui:SettingsCard.Visibility>
                                                </ui:SettingsCard>

                                                <ui:SettingsCard Header="同时显示时间"
                                                                 Description="下一段名同时显示开始时间">
                                                    <ui:ToggleSwitch IsOn="{Binding ShowTime, Mode=TwoWay}"
                                                                     OffContent="否" OnContent="是" MinWidth="0"/>
                                                    <ui:SettingsCard.Visibility>
                                                        <Binding Path="IsShowTimeRelevant" Converter="{StaticResource BoolToVisibilityConverter}"/>
                                                    </ui:SettingsCard.Visibility>
                                                </ui:SettingsCard>
                                            </ui:SettingsExpander.Items>
                                        </ui:SettingsExpander>

                                        <!-- ====== 通用设置 ====== -->
                                        <ui:SettingsExpander Header="通用设置"
                                                             Description="可见性、前后缀、字体和颜色覆盖"
                                                             IsExpanded="True">
                                            <ui:SettingsExpander.HeaderIcon>
                                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Settings_24_Regular}"/>
                                            </ui:SettingsExpander.HeaderIcon>
                                            <ui:SettingsExpander.Items>
                                                <ui:SettingsCard Header="可见"
                                                                 Description="临时隐藏而不删除">
                                                    <ui:ToggleSwitch IsOn="{Binding Visible, Mode=TwoWay}"
                                                                     OffContent="隐藏" OnContent="显示" MinWidth="0"/>
                                                </ui:SettingsCard>

                                                <ui:SettingsCard Header="前缀"
                                                                 Description="显示在内容之前的文本">
                                                    <TextBox Text="{Binding Prefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             MinWidth="100"/>
                                                </ui:SettingsCard>

                                                <ui:SettingsCard Header="后缀"
                                                                 Description="显示在内容之后的文本">
                                                    <TextBox Text="{Binding Suffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             MinWidth="100"/>
                                                </ui:SettingsCard>

                                                <ui:SettingsCard Header="字体大小覆盖"
                                                                 Description="留空使用全局字体大小">
                                                    <ui:NumberBox Value="{Binding FontSizeOverrideValue, Mode=TwoWay}"
                                                                  SpinButtonPlacementMode="Compact"
                                                                  Minimum="0" Maximum="48"
                                                                  SmallChange="1" LargeChange="2" MinWidth="90"/>
                                                </ui:SettingsCard>

                                                <ui:SettingsCard Header="颜色覆盖"
                                                                 Description="ARGB 十六进制，留空使用全局颜色">
                                                    <TextBox Text="{Binding ColorOverride, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             MinWidth="100"/>
                                                </ui:SettingsCard>
                                            </ui:SettingsExpander.Items>
                                        </ui:SettingsExpander>

                                        <!-- ====== 排序与删除 ====== -->
                                        <ui:SettingsExpander Header="排序与删除"
                                                             Description="调整排列顺序或移除此插槽">
                                            <ui:SettingsExpander.HeaderIcon>
                                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ArrowSort_24_Regular}"/>
                                            </ui:SettingsExpander.HeaderIcon>
                                            <ui:SettingsExpander.Items>
                                                <ui:SettingsCard Header="移动位置"
                                                                 Description="调整该插槽在组内的排列顺序">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Click="OnMoveSelectedUp" Padding="6,2" Margin="0,0,6,0">
                                                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="4">
                                                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ChevronUp_24_Regular}" FontSize="10"/>
                                                                <TextBlock Text="上移" FontSize="11"/>
                                                            </ikw:SimpleStackPanel>
                                                        </Button>
                                                        <Button Click="OnMoveSelectedDown" Padding="6,2">
                                                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="4">
                                                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ChevronDown_24_Regular}" FontSize="10"/>
                                                                <TextBlock Text="下移" FontSize="11"/>
                                                            </ikw:SimpleStackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </ui:SettingsCard>

                                                <ui:SettingsCard Header="删除插槽"
                                                                 Description="从组中移除此插槽">
                                                    <Button Click="OnRemoveSelectedSlot" Padding="8,2">
                                                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="4">
                                                            <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Delete_24_Regular}" FontSize="10"/>
                                                            <TextBlock Text="删除" FontSize="11"/>
                                                        </ikw:SimpleStackPanel>
                                                    </Button>
                                                </ui:SettingsCard>
                                            </ui:SettingsExpander.Items>
                                        </ui:SettingsExpander>

                                    </ikw:SimpleStackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== Tab 3: 组设置 ==================== -->
            <TabItem Header="组设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <ikw:SimpleStackPanel Spacing="{StaticResource SettingsCardSpacing}" Margin="0,4,0,0">
                    </ikw:SimpleStackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- 底部状态栏 -->
        <Border Grid.Row="4"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource AccentControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="4" Padding="10,5" Margin="0,4,0,0">
            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Info_24_Regular}" FontSize="12"
                             Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </ikw:SimpleStackPanel>
        </Border>

    </Grid>
</pages:SettingsPageBase>