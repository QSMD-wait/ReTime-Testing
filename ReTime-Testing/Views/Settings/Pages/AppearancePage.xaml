<UserControl x:Class="ReTime_Testing.Views.Settings.Pages.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ReTime_Testing.Views.Settings.Pages"
             xmlns:controls="clr-namespace:ReTime_Testing.Views.Controls"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,16,16">
        <StackPanel>

            <!-- 阴影效果开关 -->
            <controls:SettingsCard Title="进度条阴影效果"
                                    Description="控制进度条是否显示阴影效果（开启可能影响性能）"
                                    Icon="{x:Static ui:FluentSystemIcons.SquareShadow_20_Filled}"
                                    Margin="0">
                <controls:SettingsCard.ControlContent>
                    <ui:ToggleSwitch IsOn="{Binding EnableShadow, Mode=TwoWay}" OffContent="关闭" OnContent="开启" MinWidth="0"/>
                </controls:SettingsCard.ControlContent>
            </controls:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</UserControl>