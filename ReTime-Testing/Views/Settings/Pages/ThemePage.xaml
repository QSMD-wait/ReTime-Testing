<pages:SettingsPageBase x:Class="ReTime_Testing.Views.Settings.Pages.ThemePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:pages="clr-namespace:ReTime_Testing.Views.Settings.Pages"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="600">

    <ikw:SimpleStackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="4">

        <TextBlock Text="主题" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <ui:SettingsCard Header="当前主题"
                         Description="选择进度条的视觉主题样式">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.PaintBrush_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ComboBox ItemsSource="{Binding AvailableThemes}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedThemeId, Mode=TwoWay}"
                      MinWidth="120"/>
        </ui:SettingsCard>

        <ui:SettingsExpander Header="{Binding CurrentTheme.Name}"
                             Description="{Binding CurrentTheme.Description}">
            <ui:SettingsExpander.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Info_24_Regular}" />
            </ui:SettingsExpander.HeaderIcon>
            <ui:SettingsExpander.Items>
                <ui:SettingsCard Header="作者"
                                 Description="主题作者信息">
                    <TextBlock Text="{Binding CurrentTheme.Author}"
                               VerticalAlignment="Center"/>
                </ui:SettingsCard>
                <ui:SettingsCard Header="版本"
                                 Description="主题版本号">
                    <TextBlock Text="{Binding CurrentTheme.Version}"
                               VerticalAlignment="Center"/>
                </ui:SettingsCard>
                <ui:SettingsCard Header="类型"
                                 Description="主题来源类型">
                    <TextBlock Text="{Binding CurrentTheme.IsBuiltIn, Converter={StaticResource BoolToThemeTypeConverter}}"
                               VerticalAlignment="Center"/>
                </ui:SettingsCard>
            </ui:SettingsExpander.Items>
        </ui:SettingsExpander>

        <Separator Margin="0,8,0,4"/>
        <TextBlock Text="扩展" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,4"/>

        <ui:SettingsCard Header="导入主题"
                         Description="从本地文件导入第三方进度条主题（即将推出）"
                         IsEnabled="False">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.FolderOpen_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <Button Content="导入" IsEnabled="False"/>
        </ui:SettingsCard>

        <ui:SettingsCard Header="主题市场"
                         Description="浏览和下载社区主题（即将推出）"
                         IsEnabled="False">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.StoreMicrosoft_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <Button Content="浏览" IsEnabled="False"/>
        </ui:SettingsCard>

    </ikw:SimpleStackPanel>
</pages:SettingsPageBase>