<UserControl x:Class="ReTime_Testing.Views.Settings.Pages.WindowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ReTime_Testing.Views.Settings.Pages"
             xmlns:controls="clr-namespace:ReTime_Testing.Views.Controls"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,16,16">
        <StackPanel>

            <!-- 进度条位置 -->
            <controls:SettingsCard Title="进度条位置"
                                    Description="选择进度条在屏幕上的显示位置"
                                    Icon="{x:Static ui:FluentSystemIcons.ArrowMove_24_Filled}"
                                    Margin="0">
                <controls:SettingsCard.ControlContent>
                    <ComboBox SelectedValue="{Binding SelectedPosition, Mode=TwoWay}"
                              SelectedValuePath="Tag"
                              MinWidth="160">
                        <ComboBoxItem Content="顶部" Tag="top"/>
                        <ComboBoxItem Content="底部" Tag="bottom"/>
                        <ComboBoxItem Content="左侧" Tag="left"/>
                        <ComboBoxItem Content="右侧" Tag="right"/>
                    </ComboBox>
                </controls:SettingsCard.ControlContent>
            </controls:SettingsCard>

            <!-- 窗口置顶模式 -->
            <controls:SettingsCard Title="窗口置顶维持模式"
                                    Description="选择窗口层级维持模式，保持置顶状态"
                                    Icon="{x:Static ui:FluentSystemIcons.WindowAd_24_Filled}"
                                    Margin="0">
                <controls:SettingsCard.ControlContent>
                    <ComboBox SelectedValue="{Binding SelectedTopmostMode, Mode=TwoWay}"
                              SelectedValuePath="Tag"
                              MinWidth="160">
                        <ComboBoxItem Content="仅启动时（不维持）" Tag="None"/>
                        <ComboBoxItem Content="窗口层级变化时" Tag="OnDeactivated"/>
                        <ComboBoxItem Content="定时轮询（500ms）" Tag="Polling"/>
                    </ComboBox>
                </controls:SettingsCard.ControlContent>
            </controls:SettingsCard>

            <!-- 使用实际屏幕尺寸 -->
            <controls:SettingsCard Title="使用实际屏幕尺寸"
                                    Description="使用实际屏幕尺寸定位窗口，忽略系统工作区范围（进度条将覆盖任务栏及类似功能区域）"
                                    Icon="{x:Static ui:FluentSystemIcons.ResizeLarge_24_Filled}"
                                    Margin="0">
                <controls:SettingsCard.ControlContent>
                    <ui:ToggleSwitch IsOn="{Binding UseFullScreen, Mode=TwoWay}" OffContent="关闭" OnContent="开启" MinWidth="0"/>
                </controls:SettingsCard.ControlContent>
            </controls:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</UserControl>