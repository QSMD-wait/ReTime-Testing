<pages:SettingsPageBase x:Class="ReTime_Testing.Views.Settings.Pages.WindowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:pages="clr-namespace:ReTime_Testing.Views.Settings.Pages"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600">

    <ikw:SimpleStackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="4">

        <TextBlock Text="窗口" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <ui:SettingsCard Header="进度条位置"
                         Description="选择进度条在屏幕上的显示位置">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.PositionForward_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ComboBox SelectedValue="{Binding SelectedPosition, Mode=TwoWay}"
                      SelectedValuePath="Tag"
                      MinWidth="160">
                <ComboBoxItem Content="顶部" Tag="top"/>
                <ComboBoxItem Content="底部" Tag="bottom"/>
                <ComboBoxItem Content="左侧" Tag="left"/>
                <ComboBoxItem Content="右侧" Tag="right"/>
            </ComboBox>
        </ui:SettingsCard>

        <ui:SettingsCard Header="窗口置顶维持模式"
                         Description="选择窗口层级维持模式，保持置顶状态">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Pin_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ComboBox SelectedValue="{Binding SelectedTopmostMode, Mode=TwoWay}"
                      SelectedValuePath="Tag"
                      MinWidth="160">
                <ComboBoxItem Content="仅启动时（不维持）" Tag="None"/>
                <ComboBoxItem Content="窗口层级变化时" Tag="OnDeactivated"/>
                <ComboBoxItem Content="定时轮询（500ms）" Tag="Polling"/>
            </ComboBox>
        </ui:SettingsCard>

        <ui:SettingsCard Header="使用实际屏幕尺寸"
                         Description="使用实际屏幕尺寸定位窗口，忽略系统工作区范围（进度条将覆盖任务栏及类似功能区域）">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.FullScreenMaximize_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ui:ToggleSwitch IsOn="{Binding UseFullScreen, Mode=TwoWay}" OffContent="关闭" OnContent="开启" MinWidth="0"/>
        </ui:SettingsCard>

    </ikw:SimpleStackPanel>
</pages:SettingsPageBase>