<UserControl x:Class="ReTime_Testing.Views.Settings.Pages.TimePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ReTime_Testing.Views.Settings.Pages"
             xmlns:controls="clr-namespace:ReTime_Testing.Views.Controls"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="600">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,16,16">
        <StackPanel>

            <!-- 当前时间显示（Hero Card） -->
            <Border Background="{DynamicResource {x:Static ui:ThemeKeys.CardBackgroundFillColorDefaultBrushKey}}"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource {x:Static ui:ThemeKeys.CardStrokeColorDefaultBrushKey}}"
                    BorderThickness="1"
                    Padding="24,20"
                    Margin="0,0,0,16">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTime}"
                               FontSize="56"
                               FontWeight="Bold"
                               FontFamily="Consolas, Courier New, monospace"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextControlForegroundKey}}"/>
                    <TextBlock Text="{Binding CurrentDate}"
                               FontSize="14"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextControlForegroundKey}}"
                               Opacity="0.6"/>
                </StackPanel>
            </Border>

            <!-- 云端校准开关 -->
            <controls:SettingsCard Title="启用云端校准"
                                    Description="定期从NTP服务器获取时间进行校准，确保系统时间准确"
                                    Icon="{x:Static ui:FluentSystemIcons.Clock_20_Filled}"
                                    Margin="0">
                <controls:SettingsCard.ControlContent>
                    <ui:ToggleSwitch IsOn="{Binding IsCalibrationEnabled, Mode=TwoWay}" OffContent="关闭" OnContent="开启" MinWidth="0"/>
                </controls:SettingsCard.ControlContent>
            </controls:SettingsCard>

            <!-- 立即校准按钮 -->
            <controls:SettingsCard Title="手动校准"
                                    Description="立即从NTP服务器获取时间进行一次校准"
                                    Icon="{x:Static ui:FluentSystemIcons.ArrowSync_20_Filled}"
                                    Margin="0">
                <controls:SettingsCard.ControlContent>
                    <Button Content="{Binding CalibrateButtonText}"
                            Command="{Binding CalibrateNowCommand}"
                            IsEnabled="{Binding IsCalibrationEnabled}"
                            MinWidth="100"/>
                </controls:SettingsCard.ControlContent>
            </controls:SettingsCard>

            <!-- 校准状态（可展开） -->
            <controls:SettingsCard Title="校准状态"
                                    Description="{Binding CalibrationStatus}"
                                    Icon="{x:Static ui:FluentSystemIcons.Info_20_Filled}"
                                    IsExpandable="True"
                                    Margin="0">
                <controls:SettingsCard.ExpandContent>
                    <StackPanel Margin="0,8,0,0">
                        <!-- 状态行 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="运行状态"
                                       FontSize="12"
                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CalibrationStatus}"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <!-- 上次校准 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="上次校准"
                                       FontSize="12"
                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LastCalibrationTime}"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <!-- 校准详情 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="详细信息"
                                       FontSize="12"
                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CalibrationInfo}"
                                       Grid.Column="1"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </controls:SettingsCard.ExpandContent>
            </controls:SettingsCard>

            <!-- NTP服务器选择 -->
            <controls:SettingsCard Title="NTP服务器"
                                    Description="选择用于时间同步的NTP服务器"
                                    Icon="{x:Static ui:FluentSystemIcons.Cloud_20_Filled}"
                                    Margin="0">
                <controls:SettingsCard.ControlContent>
                    <ComboBox ItemsSource="{Binding NtpServers}"
                              SelectedItem="{Binding SelectedNtpServer, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              MinWidth="180"/>
                </controls:SettingsCard.ControlContent>
            </controls:SettingsCard>

            <!-- 说明信息（可展开） -->
            <controls:SettingsCard Title="关于云端校准"
                                    Description="NTP协议、RTT补偿与校准策略说明"
                                    Icon="{x:Static ui:FluentSystemIcons.QuestionCircle_20_Filled}"
                                    IsExpandable="True"
                                    Margin="0">
                <controls:SettingsCard.ExpandContent>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="NTP协议"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="NTP（网络时间协议）通过UDP 123端口与时间服务器通信，精度可达毫秒级。系统会自动补偿网络延迟（RTT/2），并将UTC时间转换为北京时间（UTC+8）。"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="校准策略"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="微调校准：偏差 ≤ 30 秒时，仅调整时钟偏移量，不触发调度状态重算，进度条平滑过渡。"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="跳跃校准：偏差 > 30 秒时，重置时钟基准并触发调度状态重新计算，确保进度条状态正确。"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                    </StackPanel>
                </controls:SettingsCard.ExpandContent>
            </controls:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</UserControl>