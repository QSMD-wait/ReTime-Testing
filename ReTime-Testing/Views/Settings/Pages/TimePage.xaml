<UserControl x:Class="ReTime_Testing.Views.Settings.Pages.TimePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ReTime_Testing.Views.Settings.Pages"
             xmlns:controls="clr-namespace:ReTime_Testing.Views.Controls"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,16,16">
        <StackPanel>

            <!-- 当前时间显示 -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="{Binding CurrentTime}"
                           FontSize="48"
                           FontWeight="SemiBold"
                           FontFamily="Consolas, Courier New, monospace"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SystemControlHighlightAccentBrush}"/>
                <TextBlock Text="{Binding CurrentDate}"
                           FontSize="16"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>

            <!-- 云端校准开关 -->
            <controls:SettingsCard Title="启用云端校准"
                                    Description="定期从云端获取时间进行校准，确保系统时间准确"
                                    Icon="{x:Static ui:FluentSystemIcons.Clock_20_Filled}"
                                    Margin="0">
                <controls:SettingsCard.ControlContent>
                    <StackPanel Orientation="Horizontal">
                        <ui:ToggleSwitch IsOn="{Binding IsCalibrationEnabled, Mode=TwoWay}" OffContent="关闭" OnContent="开启" MinWidth="0" Margin="0,0,12,0"/>
                        <Button Content="{Binding CalibrateButtonText}"
                                Command="{Binding CalibrateNowCommand}"
                                IsEnabled="{Binding IsCalibrationEnabled}"
                                MinWidth="80"/>
                    </StackPanel>
                </controls:SettingsCard.ControlContent>
            </controls:SettingsCard>

            <!-- 校准状态信息 -->
            <Border Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16"
                    Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="校准状态"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="状态:"
                                   Grid.Column="0"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CalibrationStatus}"
                                   Grid.Column="1"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="上次校准:"
                                   Grid.Column="0"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LastCalibrationTime}"
                                   Grid.Column="1"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 时间服务器选择 -->
            <controls:SettingsCard Title="时间服务器"
                                    Description="选择用于时间同步的服务器"
                                    Icon="{x:Static ui:FluentSystemIcons.Cloud_20_Filled}"
                                    Margin="0">
                <controls:SettingsCard.ControlContent>
                    <ComboBox ItemsSource="{Binding TimeServers}"
                              SelectedItem="{Binding SelectedTimeServer, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              Width="300"
                              HorizontalAlignment="Left"/>
                </controls:SettingsCard.ControlContent>
            </controls:SettingsCard>

            <!-- 校准间隔 -->
            <controls:SettingsCard Title="校准间隔"
                                    Description="云端校准的时间间隔（秒）"
                                    Icon="{x:Static ui:FluentSystemIcons.Timer_20_Filled}"
                                    Margin="0">
                <controls:SettingsCard.ControlContent>
                    <ui:NumberBox Value="{Binding IntervalSeconds, Mode=TwoWay}"
                                  Minimum="60"
                                  Maximum="3600"
                                  SmallChange="60"
                                  LargeChange="300"
                                  Width="150"
                                  HorizontalAlignment="Left"/>
                </controls:SettingsCard.ControlContent>
            </controls:SettingsCard>

            <!-- 触发阈值 -->
            <controls:SettingsCard Title="触发阈值"
                                    Description="触发校准的时间偏差阈值（秒）"
                                    Icon="{x:Static ui:FluentSystemIcons.ArrowSync_20_Filled}"
                                    Margin="0">
                <controls:SettingsCard.ControlContent>
                    <ui:NumberBox Value="{Binding TriggerSeconds, Mode=TwoWay}"
                                  Minimum="1"
                                  Maximum="60"
                                  SmallChange="1"
                                  LargeChange="5"
                                  Width="150"
                                  HorizontalAlignment="Left"/>
                </controls:SettingsCard.ControlContent>
            </controls:SettingsCard>

            <!-- 说明信息 -->
            <Border Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16"
                    Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="说明"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="• NTP服务器返回UTC时间，系统会自动转换为北京时间（UTC+8）"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="• 建议校准间隔设置为300秒（5分钟）"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="• 触发阈值建议设置为5秒，避免频繁校准"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>