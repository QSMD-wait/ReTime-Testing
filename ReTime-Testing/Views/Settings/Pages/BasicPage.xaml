<pages:SettingsPageBase x:Class="ReTime_Testing.Views.Settings.Pages.BasicPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:pages="clr-namespace:ReTime_Testing.Views.Settings.Pages"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600">

    <ikw:SimpleStackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="4">

        <TextBlock Text="基本" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <ui:SettingsExpander Header="开机自启"
                             Description="在系统启动时自动运行应用">
            <ui:SettingsExpander.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ArrowRepeatAll_24_Regular}" />
            </ui:SettingsExpander.HeaderIcon>
            <ui:ToggleSwitch IsOn="{Binding IsAutoStartEnabled, Mode=TwoWay}" OffContent="关闭" OnContent="开启" MinWidth="0"/>
            <ui:SettingsExpander.Items>
                <ui:SettingsCard Header="自启动工作方式">
                    <ComboBox SelectedValue="{Binding SelectedAutoStartMethod}"
                              SelectedValuePath="Tag"
                              MinWidth="160">
                        <ComboBoxItem Content="注册表" Tag="registry"/>
                        <ComboBoxItem Content="启动文件夹" Tag="startupFolder"/>
                    </ComboBox>
                </ui:SettingsCard>
            </ui:SettingsExpander.Items>
        </ui:SettingsExpander>

        <ui:SettingsCard Header="应用主题"
                         Description="选择应用的明暗主题">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.DarkTheme_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ComboBox SelectedValue="{Binding SelectedTheme}"
                      SelectedValuePath="Tag"
                      MinWidth="120">
                <ComboBoxItem Content="明亮" Tag="light"/>
                <ComboBoxItem Content="暗黑" Tag="dark"/>
            </ComboBox>
        </ui:SettingsCard>

        <ui:SettingsCard Header="流畅优化"
                         Description="开启后禁用 Loading 状态进度条阴影，提升应用流畅度">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Rocket_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ui:ToggleSwitch IsOn="{Binding IsSmoothnessOptimizationEnabled, Mode=TwoWay}" OffContent="关闭" OnContent="开启" MinWidth="0"/>
        </ui:SettingsCard>

        <ui:SettingsExpander Header="日志配置"
                             Description="管理应用日志的输出方式和保留策略">
            <ui:SettingsExpander.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.DocumentSearch_24_Regular}" />
            </ui:SettingsExpander.HeaderIcon>
            <ui:ToggleSwitch IsOn="{Binding IsFileLogEnabled, Mode=TwoWay}" OffContent="关闭" OnContent="开启" MinWidth="0"/>
            <ui:SettingsExpander.Items>
                <ui:SettingsCard Header="最低日志等级"
                                 Description="仅输出该等级及以上的日志">
                    <ComboBox ItemsSource="{Binding LogLevelNames}"
                              SelectedIndex="{Binding SelectedLogLevelIndex, Mode=TwoWay}"
                              MinWidth="160"/>
                </ui:SettingsCard>
                <ui:SettingsCard Header="日志保留天数"
                                 Description="超过该天数的日志文件将被自动清理">
                    <StackPanel Orientation="Horizontal">
                        <ui:NumberBox Value="{Binding RetainedDays, Mode=TwoWay}"
                                      SpinButtonPlacementMode="Compact"
                                      Minimum="1"
                                      Maximum="365"
                                      SmallChange="1"
                                      LargeChange="10"
                                      MinWidth="100"/>
                        <TextBlock Text="天(d)"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </ui:SettingsCard>
                <ui:SettingsCard Header="单文件大小上限"
                                 Description="单个日志文件达到该大小后将自动滚动创建新文件">
                    <StackPanel Orientation="Horizontal">
                        <ui:NumberBox Value="{Binding FileSizeLimitMB, Mode=TwoWay}"
                                      SpinButtonPlacementMode="Compact"
                                      Minimum="1"
                                      Maximum="100"
                                      SmallChange="1"
                                      LargeChange="5"
                                      MinWidth="100"/>
                        <TextBlock Text=" MB "
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </ui:SettingsCard>
            </ui:SettingsExpander.Items>
        </ui:SettingsExpander>

    </ikw:SimpleStackPanel>
</pages:SettingsPageBase>