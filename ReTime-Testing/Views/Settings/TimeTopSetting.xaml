<Window x:Class="ReTime_Testing.Views.Settings.TimeTopSetting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReTime_Testing.Views.Settings"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        mc:Ignorable="d"
        Title="设置"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:TitleBar.Height="36"
        Width="800"
        Height="600"
        MinWidth="400"
        MinHeight="500">
    
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32">
                <TextBlock Text="TimeTopDesktop 设置"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="0,0,0,24"/>

                <!-- 状态切换 -->
                <TextBlock Text="状态控制"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>
                
                <!-- 状态切换按钮 -->
                <Button Content="Loading 状态"
                           Command="{Binding SetLoadingCommand}"
                           IsEnabled="{Binding IsStateControlsEnabled}"
                           Width="150"
                           Height="32"
                           Margin="0,0,0,8"/>
                
                <Button Content="Success 状态"
                           Command="{Binding SetSuccessCommand}"
                           IsEnabled="{Binding IsStateControlsEnabled}"
                           Width="150"
                           Height="32"
                           Margin="0,0,0,8"/>
                
                <Button Content="Error 状态"
                           Command="{Binding SetErrorCommand}"
                           IsEnabled="{Binding IsStateControlsEnabled}"
                           Width="150"
                           Height="32"
                           Margin="0,0,0,8"/>
                
                <Button Content="Paused 状态"
                           Command="{Binding SetPausedCommand}"
                           IsEnabled="{Binding IsStateControlsEnabled}"
                           Width="150"
                           Height="32"
                           Margin="0,0,0,8"/>
                
                <Button Content="Progress 状态 (50%)"
                           Command="{Binding SetProgressCommand}"
                           IsEnabled="{Binding IsStateControlsEnabled}"
                           Width="150"
                           Height="32"
                           Margin="0,0,0,24"/>
                
                <!-- 进度值控制 -->
                <TextBlock Text="进度值"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                    <Slider Value="{Binding ProgressValue}"
                            Minimum="0"
                            Maximum="100"
                            Width="300"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding ProgressValue, StringFormat={}{0:F0}%}"
                               Width="50"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- 时间控制 -->
                <TextBlock Text="时间控制"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>
                
                <TextBlock Text="设置开始和结束时间，进度条将按时间段前进"
                           FontSize="12"
                           Foreground="Gray"
                           Margin="0,0,0,8"/>
                
                <!-- 开始时间 -->
                <TextBlock Text="开始时间"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <ComboBox ItemsSource="{Binding Hours}"
                                SelectedItem="{Binding StartHour}"
                                Width="80"
                                HorizontalAlignment="Left"/>
                    <TextBlock Text="时"
                               VerticalAlignment="Center"
                               Margin="4,0,4,0"/>
                    <ComboBox ItemsSource="{Binding Minutes}"
                                SelectedItem="{Binding StartMinute}"
                                Width="80"
                                HorizontalAlignment="Left"/>
                    <TextBlock Text="分"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                </StackPanel>
                
                <!-- 结束时间 -->
                <TextBlock Text="结束时间"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <ComboBox ItemsSource="{Binding Hours}"
                                SelectedItem="{Binding EndHour}"
                                Width="80"
                                HorizontalAlignment="Left"/>
                    <TextBlock Text="时"
                               VerticalAlignment="Center"
                               Margin="4,0,4,0"/>
                    <ComboBox ItemsSource="{Binding Minutes}"
                                SelectedItem="{Binding EndMinute}"
                                Width="80"
                                HorizontalAlignment="Left"/>
                    <TextBlock Text="分"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                </StackPanel>
                
                <!-- 时间控制按钮 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="开始"
                               Command="{Binding StartTimerCommand}"
                               Width="120"
                               Height="32"
                               Margin="0,0,8,0"/>
                    
                    <Button Content="停止"
                               Command="{Binding StopTimerCommand}"
                               Width="120"
                               Height="32"/>
                </StackPanel>
                
                <!-- 当前进度 -->
                <TextBlock Text="当前进度"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                
                <TextBlock Text="{Binding TimerProgress, StringFormat={}{0:F1}%}"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="Blue"
                           Margin="0,0,0,8"/>
                
                <TextBlock Text="{Binding TimerStatus}"
                           FontSize="12"
                           Foreground="Gray"
                           Margin="0,0,0,32"/>

                <!-- 互斥锁调试 -->
                <TextBlock Text="互斥锁调试"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <TextBlock Text="用于调试互斥锁功能，测试多实例检测"
                           FontSize="12"
                           Foreground="Gray"
                           Margin="0,0,0,8"/>

                <!-- 互斥锁状态信息 -->
                <Border Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="互斥锁状态信息"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="互斥锁状态:"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MutexStatus}"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMutexAcquired}" Value="True">
                                                <Setter Property="Foreground" Value="Green"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMutexAcquired}" Value="False">
                                                <Setter Property="Foreground" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="互斥锁 ID:"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MutexId}"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="是否启用:"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding IsMutexEnabled}"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="启用"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMutexEnabled}" Value="False">
                                                <Setter Property="Text" Value="禁用"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 互斥锁操作按钮 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="释放互斥锁"
                            Command="{Binding ReleaseMutexCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"
                            ToolTip="释放互斥锁，允许新实例启动"/>

                    <Button Content="重新获取"
                            Command="{Binding ReacquireMutexCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"
                            ToolTip="重新尝试获取互斥锁"/>

                    <Button Content="切换启用状态"
                            Command="{Binding ToggleMutexEnabledCommand}"
                            Width="120"
                            Height="32"
                            ToolTip="切换互斥锁的启用/禁用状态"/>
                </StackPanel>

                <TextBlock Text="提示：修改互斥锁状态后，请重新启动应用程序测试多实例功能"
                           FontSize="12"
                           Foreground="Orange"
                           TextWrapping="Wrap"
                           Margin="0,0,0,32"/>

                <!-- 进度条位置控制 -->
                <TextBlock Text="进度条位置控制"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <TextBlock Text="调整进度条在屏幕上的位置（上、下、左、右）"
                           FontSize="12"
                           Foreground="Gray"
                           Margin="0,0,0,8"/>

                <!-- 位置状态信息 -->
                <Border BorderBrush="Gray"
                        BorderThickness="1"
                        Background="#F5F5F5"
                        Padding="16"
                        Margin="0,0,0,16"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="当前位置状态:"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="当前位置: "
                                       Width="120"/>
                            <TextBlock Text="{Binding PositionText}"
                                       FontWeight="SemiBold"
                                       Foreground="Blue"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 位置切换按钮 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="顶部"
                            Command="{Binding SetPositionTopCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"
                            ToolTip="将进度条切换到顶部"/>

                    <Button Content="底部"
                            Command="{Binding SetPositionBottomCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"
                            ToolTip="将进度条切换到底部"/>

                    <Button Content="左侧"
                            Command="{Binding SetPositionLeftCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"
                            ToolTip="将进度条切换到左侧"/>

                    <Button Content="右侧"
                            Command="{Binding SetPositionRightCommand}"
                            Width="120"
                            Height="32"
                            ToolTip="将进度条切换到右侧"/>
                </StackPanel>

                <TextBlock Text="提示：切换位置会关闭当前窗口并创建新窗口"
                           FontSize="12"
                           Foreground="Orange"
                           TextWrapping="Wrap"
                           Margin="0,0,0,32"/>

                <!-- GlobalTimeTopDesktopService API 调试 -->
                <TextBlock Text="GlobalTimeTopDesktopService API 调试"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <TextBlock Text="测试进度条服务的所有公共 API"
                           FontSize="12"
                           Foreground="Gray"
                           Margin="0,0,0,8"/>

                <!-- 额外状态控制 -->
                <TextBlock Text="额外状态控制"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="Hidden 状态"
                            Command="{Binding SetHiddenCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="Disabled 状态"
                            Command="{Binding SetDisabledCommand}"
                            Width="120"
                            Height="32"/>
                </StackPanel>

                <!-- 可见性控制 -->
                <TextBlock Text="可见性控制"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="Visible"
                            Command="{Binding SetVisibilityVisibleCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="Hidden"
                            Command="{Binding SetVisibilityHiddenCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="Collapsed"
                            Command="{Binding SetVisibilityCollapsedCommand}"
                            Width="120"
                            Height="32"/>
                </StackPanel>

                <!-- 启用状态控制 -->
                <TextBlock Text="启用状态控制"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="Enabled"
                            Command="{Binding SetEnabledTrueCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="Disabled"
                            Command="{Binding SetEnabledFalseCommand}"
                            Width="120"
                            Height="32"/>
                </StackPanel>

                <!-- 透明度控制 -->
                <TextBlock Text="透明度控制"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="1.0 (100%)"
                            Command="{Binding SetOpacityFullCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="0.5 (50%)"
                            Command="{Binding SetOpacityHalfCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="0.2 (20%)"
                            Command="{Binding SetOpacityLowCommand}"
                            Width="120"
                            Height="32"/>
                </StackPanel>

                <!-- 前景色控制 -->
                <TextBlock Text="前景色控制"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="蓝色"
                            Command="{Binding SetForegroundBlueCommand}"
                            Width="100"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="绿色"
                            Command="{Binding SetForegroundGreenCommand}"
                            Width="100"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="红色"
                            Command="{Binding SetForegroundRedCommand}"
                            Width="100"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="橙色"
                            Command="{Binding SetForegroundOrangeCommand}"
                            Width="100"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="灰色"
                            Command="{Binding SetForegroundGrayCommand}"
                            Width="100"
                            Height="32"/>
                </StackPanel>

                <!-- 背景色控制 -->
                <TextBlock Text="背景色控制"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="透明"
                            Command="{Binding SetBackgroundTransparentCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="浅灰色"
                            Command="{Binding SetBackgroundLightGrayCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="白色"
                            Command="{Binding SetBackgroundWhiteCommand}"
                            Width="120"
                            Height="32"/>
                </StackPanel>

                <!-- 范围控制 -->
                <TextBlock Text="范围控制"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="0-100"
                            Command="{Binding SetRange0100Command}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="0-1"
                            Command="{Binding SetRange01Command}"
                            Width="120"
                            Height="32"/>
                </StackPanel>

                <!-- 其他操作 -->
                <TextBlock Text="其他操作"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="重置状态"
                            Command="{Binding ResetStateCommand}"
                            Width="120"
                            Height="32"
                            Margin="0,0,8,0"/>

                    <Button Content="批量更新测试"
                            Command="{Binding BatchUpdateTestCommand}"
                            Width="150"
                            Height="32"/>
                </StackPanel>

                <TextBlock Text="提示：批量更新测试会同时设置进度为 75%、前景色为绿色、透明度为 0.8、可见性为 Visible"
                           FontSize="12"
                           Foreground="Orange"
                           TextWrapping="Wrap"
                           Margin="0,0,0,32"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</Window>