<Window x:Class="ReTime_Testing.Views.Settings.Setting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:settings="clr-namespace:ReTime_Testing.Views.Settings"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        mc:Ignorable="d"
        Title="设置"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:TitleBar.Height="36"
        ui:TitleBar.IsIconVisible="False"
        Width="1100"
        Height="600"
        MinWidth="600"
        MinHeight="400">

    <!-- 页面实例由代码后置缓存并直接填充到 PageHost，无需按 ViewModel 类型映射的数据模板 -->
    <Window.Resources/>

    <Grid>
        <ui:NavigationView x:Name="MainNavigation"
                           AlwaysShowHeader="False"
                           IsTabStop="False"
                           IsBackEnabled="False"
                           IsBackButtonVisible="Collapsed"
                           IsSettingsVisible="False"
                           PaneDisplayMode="Auto"
                           CompactModeThresholdWidth="599"
                           OpenPaneLength="280"
                           CompactPaneLength="48">

            <!-- 主要导航项 -->
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="基本" Tag="Basic">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Home_24_Regular}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="外观" Tag="Appearance">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ColorBackground_24_Regular}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="时间" Tag="Time">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Clock_24_Regular}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="文字栏" Tag="TextOverlay">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.TextT_24_Regular}"/>
                    </ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="全局设置" Tag="TextOverlay">
                            <ui:NavigationViewItem.Icon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Settings_24_Regular}"/>
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="组件配置" Tag="TextOverlayLayout">
                            <ui:NavigationViewItem.Icon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Grid_24_Regular}"/>
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="窗口" Tag="Window">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.WindowAd_24_Regular}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="主题" Tag="Theme">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.PaintBrush_24_Regular}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <!-- 页脚导航项 -->
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="关于 ReTime - Testing" Tag="About">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Info_24_Regular}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <!-- 导航列表底部留白 -->
            <ui:NavigationView.PaneFooter>
                <Border Height="16"/>
            </ui:NavigationView.PaneFooter>

            <!-- 内容区域：页面实例由代码后置缓存并填充 -->
            <ui:NavigationView.Content>
                <ContentControl x:Name="PageHost"/>
            </ui:NavigationView.Content>

        </ui:NavigationView>
    </Grid>

</Window>