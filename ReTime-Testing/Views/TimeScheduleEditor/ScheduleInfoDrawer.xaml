<UserControl x:Class="ReTime_Testing.Views.TimeScheduleEditor.ScheduleInfoDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="360">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Padding="20,14" BorderBrush="{DynamicResource {x:Static ui:ThemeKeys.ControlStrokeColorDefaultBrushKey}}"
                BorderThickness="0,0,0,1">
            <TextBlock Text="计划表信息" FontSize="16" FontWeight="SemiBold"/>
        </Border>

        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel x:Name="InfoPanel" Margin="0,0,0,8">

                <!-- 名称 -->
                <TextBlock Text="名称" FontSize="12" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}" Margin="0,0,0,6"/>
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NameBox" Grid.Column="0" IsReadOnly="True" Padding="8,6" LostFocus="OnFieldChanged"/>
                    <Button x:Name="NameEditButton" Grid.Column="1"
                            Content="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="11"
                            Width="28" Height="28" Padding="0"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center" ToolTip="编辑名称"
                            Background="Transparent" BorderBrush="Transparent"
                            Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"
                            Click="OnNameEditClick"/>
                </Grid>

                <!-- 描述 -->
                <TextBlock Text="描述" FontSize="12" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}" Margin="0,16,0,6"/>
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DescBox" Grid.Column="0" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100"
                             VerticalScrollBarVisibility="Auto" Padding="8,6" LostFocus="OnFieldChanged"/>
                    <Button x:Name="DescEditButton" Grid.Column="1"
                            Content="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="11"
                            Width="28" Height="28" Padding="0"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center" ToolTip="编辑描述"
                            Background="Transparent" BorderBrush="Transparent"
                            Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"
                            Click="OnDescEditClick"/>
                </Grid>

                <!-- 自动启用 -->
                <TextBlock Text="自动启用" FontSize="12" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}" Margin="0,16,0,6"/>
                <TextBlock Text="关闭后此表不会在组轮换中被选中" FontSize="11"
                           Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}" Margin="0,0,0,6"/>
                <ui:ToggleSwitch x:Name="EnableToggle" OnContent="启用" OffContent="启用" IsOn="True" HorizontalAlignment="Left" Toggled="OnEnableToggled"/>

                <!-- 归属组 -->
                <TextBlock Text="归属组" FontSize="12" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}" Margin="0,16,0,6"/>
                <ComboBox x:Name="GroupComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                          MinWidth="160" HorizontalAlignment="Stretch" Padding="8,6" SelectionChanged="OnFieldChanged"/>

                <!-- 星期几 -->
                <TextBlock Text="星期几" FontSize="12" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}" Margin="0,16,0,6"/>
                <TextBlock Text="此表将在星期几生效" FontSize="11"
                           Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}" Margin="0,0,0,6"/>
                <ComboBox x:Name="DayComboBox" MinWidth="120" HorizontalAlignment="Left" Padding="8,6" SelectionChanged="OnFieldChanged">
                    <ComboBoxItem Content="周日" Tag="0"/>
                    <ComboBoxItem Content="周一" Tag="1"/>
                    <ComboBoxItem Content="周二" Tag="2"/>
                    <ComboBoxItem Content="周三" Tag="3"/>
                    <ComboBoxItem Content="周四" Tag="4"/>
                    <ComboBoxItem Content="周五" Tag="5"/>
                    <ComboBoxItem Content="周六" Tag="6"/>
                </ComboBox>

                <!-- 每N周 -->
                <TextBlock Text="每N周" FontSize="12" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}" Margin="0,16,0,6"/>
                <TextBlock Text="1=每周, 2=每两周, 3=每三周..." FontSize="11"
                           Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}" Margin="0,0,0,6"/>
                <TextBox x:Name="CycleBox" MinWidth="60" HorizontalAlignment="Left" Padding="8,6" LostFocus="OnFieldChanged"/>

                <!-- 第几周 -->
                <TextBlock x:Name="WeekLabel" Text="第几周" FontSize="12" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}" Margin="0,16,0,6"/>
                <TextBlock x:Name="WeekInfo" Text="0=每周, 1=第1周, 2=第2周..." FontSize="11"
                           Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}" Margin="0,0,0,6"/>
                <TextBox x:Name="WeekBox" MinWidth="60" HorizontalAlignment="Left" Padding="8,6" LostFocus="OnFieldChanged"/>

                <!-- ID -->
                <TextBlock Text="ID" FontSize="11" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}" Margin="0,20,0,6"/>
                <TextBox x:Name="IdBox" IsReadOnly="True" IsEnabled="False" Padding="8,6"
                         Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
