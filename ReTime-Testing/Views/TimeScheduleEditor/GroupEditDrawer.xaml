<UserControl x:Class="ReTime_Testing.Views.TimeScheduleEditor.GroupEditDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="360">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Padding="20,14" BorderBrush="{DynamicResource {x:Static ui:ThemeKeys.ControlStrokeColorDefaultBrushKey}}"
                BorderThickness="0,0,0,1">
            <TextBlock Text="表组设置" FontSize="16" FontWeight="SemiBold"/>
        </Border>

        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel Margin="0,0,0,8">

                <!-- 组名（直接编辑；默认组受保护时只读） -->
                <TextBlock Text="组名" FontSize="12" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}" Margin="0,0,0,6"/>
                <TextBox x:Name="GroupNameBox" Padding="8,6"
                         TextChanged="OnFieldChanged"/>

                <!-- 描述（直接编辑） -->
                <TextBlock Text="描述" FontSize="12" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}" Margin="0,16,0,6"/>
                <TextBox x:Name="GroupDescBox"
                         AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100"
                         VerticalScrollBarVisibility="Auto" Padding="8,6"
                         TextChanged="OnFieldChanged"/>

                <Separator Margin="0,20" BorderBrush="{DynamicResource {x:Static ui:ThemeKeys.ControlStrokeColorDefaultBrushKey}}"/>

                <!-- 轮换设置 -->
                <TextBlock Text="轮换设置" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <!-- 轮换周期数 -->
                <TextBlock Text="轮换周期数" FontSize="12" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}" Margin="0,0,0,6"/>
                <ui:NumberBox x:Name="CycleCountBox" Minimum="1" Maximum="9"
                              SpinButtonPlacementMode="Compact" HorizontalAlignment="Left"
                              Margin="0,0,0,12"
                              ValueChanged="OnCycleCountChanged"/>

                <!-- 轮换起始日期 -->
                <TextBlock Text="轮换起始日期" FontSize="12" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}" Margin="0,0,0,6"/>
                <DatePicker x:Name="StartDatePicker" HorizontalAlignment="Left"
                            Margin="0,0,0,12"
                            SelectedDateChanged="OnStartDateChanged"/>

                <!-- 轮换偏移量 -->
                <TextBlock Text="轮换偏移量" FontSize="12" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}" Margin="0,0,0,6"/>
                <ui:NumberBox x:Name="OffsetBox" Minimum="-9" Maximum="9"
                              SpinButtonPlacementMode="Compact" HorizontalAlignment="Left"
                              Margin="0,0,0,4"
                              ValueChanged="OnOffsetChanged"/>

                <!-- 分隔：轮换设置 | 日期覆盖（天→表映射与轮转覆盖由一级编排页 GroupWeekArrangement 负责） -->
                <Separator x:Name="DateSectionSeparator" Margin="0,20"
                           BorderBrush="{DynamicResource {x:Static ui:ThemeKeys.ControlStrokeColorDefaultBrushKey}}"/>

                <!-- 日期覆盖 -->
                <StackPanel x:Name="DateOverrideSection">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="日期覆盖" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="AddDateOverrideButton" HorizontalAlignment="Right" Padding="10,4"
                                Click="OnAddDateOverrideClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="添加" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="DateEmptyHint" Text="暂无日期覆盖，可为特定日期指定计划表"
                               FontSize="12" Margin="0,0,0,8"
                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}"/>
                    <ItemsControl x:Name="DateOverrideList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <DatePicker Grid.Column="0" SelectedDate="{Binding Date, Mode=TwoWay}"/>
                                    <ComboBox Grid.Column="1" Margin="6,0,0,0" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding ScheduleOptions}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding ScheduleId, Mode=TwoWay}"/>
                                    <Button Grid.Column="2" Content="&#xE74D;" FontFamily="Segoe Fluent Icons"
                                            FontSize="11" Width="28" Height="28" Padding="0" Margin="6,0,0,0"
                                            ToolTip="移除此条日期覆盖"
                                            Background="Transparent" BorderBrush="Transparent"
                                            Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"
                                            Click="OnRemoveDateOverrideClick"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Separator Margin="0,20" BorderBrush="{DynamicResource {x:Static ui:ThemeKeys.ControlStrokeColorDefaultBrushKey}}"/>

                <!-- 操作：解散为危险操作，经 ui:Flyout 二次确认 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                    <Button x:Name="ActivateGroupButton" Content="激活此组"
                            Margin="0,0,8,0" Click="OnActivateGroupClick"/>
                    <Button x:Name="DissolveGroupButton" Content="解散此组"
                            ui:FlyoutService.FlyoutOpeningMode="Click">
                        <ui:FlyoutService.Flyout>
                            <ui:Flyout x:Name="DissolveConfirmFlyout" Placement="Top">
                                <StackPanel Width="240">
                                    <TextBlock x:Name="DissolveConfirmTitle" Text="确定要解散此表组吗？"
                                               FontSize="13" FontWeight="SemiBold"
                                               Margin="0,0,0,6"
                                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"/>
                                    <TextBlock Text="该组将被删除，已创建的计划表不受影响。" FontSize="12" TextWrapping="Wrap"
                                               Margin="0,0,0,12"
                                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="取消" Margin="0,0,8,0" Click="OnDissolveCancelClick"/>
                                        <Button Content="确认解散" Click="OnDissolveConfirmClick"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:Flyout>
                        </ui:FlyoutService.Flyout>
                    </Button>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
