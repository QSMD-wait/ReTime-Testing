<UserControl x:Class="ReTime_Testing.Views.TimeScheduleEditor.GroupWeekArrangement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="720">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <!-- 周视图风格：一个轮转周一张指派行表，周期内各周纵向堆叠 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly" PanningRatio="2.0" PanningDeceleration="0.2"
                  Style="{DynamicResource {x:Static ui:ThemeKeys.DefaultScrollViewerStyleKey}}">
        <ItemsControl x:Name="WeekTablesControl" Margin="12,4,12,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- 单个轮转周的表格组 -->
                    <Border Margin="0,0,0,12" CornerRadius="6"
                            Background="{DynamicResource {x:Static ui:ThemeKeys.CardBackgroundFillColorDefaultBrushKey}}"
                            BorderBrush="{DynamicResource {x:Static ui:ThemeKeys.CardStrokeColorDefaultBrushKey}}"
                            BorderThickness="1">
                        <StackPanel>
                            <!-- 标题行：周名 + 本周徽标 + 差异摘要 -->
                            <Grid Margin="12,10,12,8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"/>
                                    <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="3" VerticalAlignment="Center"
                                            Background="{DynamicResource {x:Static ui:ThemeKeys.AccentFillColorDefaultBrushKey}}"
                                            Visibility="{Binding IsCurrentWeek, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="本周" FontSize="10"
                                                   Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Summary}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}"/>
                            </Grid>

                            <!-- 指派行表：7 天列（周一 → 周日） -->
                            <ItemsControl ItemsSource="{Binding Cells}" Margin="12,0,12,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 天列容器：左侧分隔线 -->
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource {x:Static ui:ThemeKeys.CardStrokeColorDefaultBrushKey}}"/>
                                                    <Setter Property="BorderThickness" Value="1,0,0,0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                            <Setter Property="BorderThickness" Value="0,0,0,0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <!-- 今日列顶强调线（常态占位透明，保证各列表头对齐） -->
                                                <Border Height="3">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource {x:Static ui:ThemeKeys.AccentFillColorDefaultBrushKey}}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <!-- 表头行：星期 + 轮转标签 -->
                                                <Border Padding="8,5,8,6"
                                                        BorderBrush="{DynamicResource {x:Static ui:ThemeKeys.CardStrokeColorDefaultBrushKey}}"
                                                        BorderThickness="0,0,0,1"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.CardBackgroundFillColorSecondaryBrushKey}}">
                                                    <Grid>
                                                        <!-- 星期名（今日列强调色） -->
                                                        <TextBlock Text="{Binding DayName}" FontSize="12"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                            <Setter Property="Foreground"
                                                                                    Value="{DynamicResource {x:Static ui:ThemeKeys.AccentFillColorDefaultBrushKey}}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <!-- 轮转周标签：相同（中性）/ 不同（强调色） -->
                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                Padding="5,1" CornerRadius="3"
                                                                Visibility="{Binding ShowRotationTags, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DiffersFromBase}" Value="True">
                                                                            <Setter Property="Background"
                                                                                    Value="{DynamicResource {x:Static ui:ThemeKeys.AccentFillColorDefaultBrushKey}}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding TagText}" FontSize="10"
                                                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- 指派行：点击弹出 ui:Flyout 选择计划表 -->
                                                <Button Click="OnCellClick" Height="40" Padding="6,0"
                                                        MinWidth="0" HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Center"
                                                        ToolTip="{Binding DisplayName}"
                                                        ui:FlyoutService.FlyoutOpeningMode="Click">
                                                    <ui:FlyoutService.Flyout>
                                                        <ui:Flyout Placement="Bottom">
                                                            <!-- 收紧外框内边距与边框 -->
                                                            <ui:Flyout.FlyoutPresenterStyle>
                                                                <Style TargetType="ui:FlyoutPresenter"
                                                                       BasedOn="{StaticResource {x:Type ui:FlyoutPresenter}}">
                                                                    <Setter Property="Padding" Value="4"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                </Style>
                                                            </ui:Flyout.FlyoutPresenterStyle>
                                                            <!-- 选项与当前选择由 OnCellClick 命令式装配（游离元素绑定不刷新） -->
                                                            <ui:ListView DisplayMemberPath="Name"
                                                                      SelectedValuePath="Id"
                                                                      MinWidth="180" MaxHeight="300"
                                                                      Padding="0" BorderThickness="0"
                                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                      SelectionChanged="OnOptionSelectionChanged"
                                                                      PreviewMouseLeftButtonUp="OnOptionClick">
                                                                <!-- 行内边距收紧；空选项（（未设置）/（按第一周安排））斜体显示 -->
                                                                <ui:ListView.ItemContainerStyle>
                                                                    <Style TargetType="ui:ListViewItem"
                                                                           BasedOn="{StaticResource {x:Type ui:ListViewItem}}">
                                                                        <Setter Property="Padding" Value="8,3"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ui:ListView.ItemContainerStyle>
                                                            </ui:ListView>
                                                        </ui:Flyout>
                                                    </ui:FlyoutService.Flyout>
                                                    <DockPanel LastChildFill="True" Margin="4,0">
                                                        <!-- 空位显示"+ 选择计划表" -->
                                                        <ui:FontIcon DockPanel.Dock="Left"
                                                                     Icon="{x:Static ui:SegoeFluentIcons.Add}"
                                                                     FontSize="12" Margin="0,0,6,0"
                                                                     VerticalAlignment="Center"
                                                                     Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                            <Setter Property="Foreground"
                                                                                    Value="{DynamicResource {x:Static ui:ThemeKeys.AccentFillColorDefaultBrushKey}}"/>
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        </DataTrigger>
                                                                        <!-- 轮转周沿用第一周：灰色斜体以示区分 -->
                                                                        <DataTrigger Binding="{Binding IsInherited}" Value="True">
                                                                            <Setter Property="Foreground"
                                                                                    Value="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}"/>
                                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DockPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
