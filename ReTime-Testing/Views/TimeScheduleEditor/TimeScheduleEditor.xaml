                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding SelectedGroup, Converter={StaticResource NullToVisibilityConverter}}">
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.NewFolder}"
                                         FontSize="48" HorizontalAlignment="Center"
                                         Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}"/>
                            <TextBlock Text="请选择一个表组" FontSize="16" Margin="0,16,0,4"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                            <TextBlock Text="从左侧列表选择或新建一个表组" FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}"/>
                        </StackPanel>

                        <!-- 组详情 -->
                        <ScrollViewer Visibility="{Binding SelectedGroup, Converter={StaticResource NotNullToVisibilityConverter}}"
                                      VerticalScrollBarVisibility="Auto" Margin="16">
                            <StackPanel>
                                <!-- 组名 -->
                                <TextBlock Text="组名" FontSize="12" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedGroup.Name}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <!-- 成员数 -->
                                <TextBlock Text="成员" FontSize="12" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}" Margin="0,0,0,4"/>
                                <TextBlock FontSize="14" Margin="0,0,0,12">
                                    <Run Text="共"/><Run Text="{Binding SelectedGroup.MemberCount, Mode=OneWay}"/><Run Text="张计划表"/>
                                </TextBlock>

                                <!-- 轮换状态 -->
                                <TextBlock Text="轮换状态" FontSize="12" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedGroup.RotationInfo, FallbackValue='每周'}" FontSize="14" Margin="0,0,0,16"/>

                                <!-- 操作按钮 -->
                                <Button Content="激活此组" Command="{Binding ActivateGroupByIdCommand}"
                                        CommandParameter="{Binding SelectedGroup.Id}"
                                        HorizontalAlignment="Left" Margin="0,0,0,8"
                                        Padding="16,6"/>
                                <Button Content="解散此组" Command="{Binding DisbandGroupCommand}"
                                        CommandParameter="{Binding SelectedGroup.Id}"
                                        HorizontalAlignment="Left"
                                        Padding="16,6"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <ui:CommandBar Grid.Column="1"
                       VerticalAlignment="Top"
                       DefaultLabelPosition="Right"
                       IsOpen="False">
            <ui:AppBarButton Label="加载" Click="OnReloadButtonClick" RenderTransformOrigin="-0.822,0.675">
                <ui:AppBarButton.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.OpenFile}"/>
                </ui:AppBarButton.Icon>
            </ui:AppBarButton>
            <ui:AppBarButton Label="保存" Command="{Binding SaveCommand}" RenderTransformOrigin="-0.822,0.675">
                <ui:AppBarButton.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Save}"/>
                </ui:AppBarButton.Icon>
            </ui:AppBarButton>
        </ui:CommandBar>

        <!-- Toast 通知容器 -->
        <controls:ToastOverlay x:Name="ToastOverlayControl"
                               Grid.Column="0" Grid.ColumnSpan="2"
                               Margin="0,0,16,16"/>
    </Grid>

</Window>