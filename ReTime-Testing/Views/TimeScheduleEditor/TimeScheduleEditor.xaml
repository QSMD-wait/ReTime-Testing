<Window x:Class="ReTime_Testing.Views.TimeScheduleEditor.TimeScheduleEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:controls="clr-namespace:ReTime_Testing.Controls"
        xmlns:localconv="clr-namespace:ReTime_Testing.Helpers"
        mc:Ignorable="d"
        Title="时间计划表编辑器"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:TitleBar.Height="36"
        Width="1100"
        Height="700"
        MinWidth="800"
        MinHeight="500">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <localconv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <localconv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <localconv:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
        <localconv:BindingProxy x:Key="ViewModelProxy" Data="{Binding}"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TabControl Grid.Column="0" Grid.ColumnSpan="2"
                    Style="{StaticResource TabControlPivotStyle}"
                    Padding="0">
            <!-- 预览选项 -->
            <TabItem Header="预览">
                <Grid Margin="16">
                    <TextBlock Text="预览区域 - 开发中"
                               FontSize="16"
                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </TabItem>

            <!-- 计划表选项 -->
            <TabItem Header="计划表">
                <!-- 根Grid：左侧列表 | 右侧Tab(时间段/时间点) -->
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" MinWidth="180" MaxWidth="400"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="500"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. 左侧面板：计划表列表 -->
                    <Grid Grid.Column="0" Background="{DynamicResource {x:Static ui:ThemeKeys.CardBackgroundFillColorDefaultBrushKey}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 左侧操作按钮 -->
                        <ui:CommandBar Grid.Row="0" DefaultLabelPosition="Right" Margin="4,4,4,0" HorizontalAlignment="Left">
                            <ui:AppBarButton Label="添加" ToolTip="新建计划表" Command="{Binding AddScheduleCommand}">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Add}"/>
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>
                            <ui:AppBarButton Label="复制" ToolTip="复制选中的计划表" Command="{Binding CopyScheduleCommand}">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Copy}"/>
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>
                        </ui:CommandBar>

                        <!-- 计划表列表 -->
                        <ListView x:Name="ScheduleListView" Grid.Row="1" Margin="4" ItemsSource="{Binding Schedules}"
                                  SelectedItem="{Binding SelectedSchedule, Mode=TwoWay}"
                                  IsEnabled="True" SelectionMode="Single"
                                  PreviewMouseRightButtonDown="OnScheduleListPreviewMouseRightButtonDown">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="复制"
                                                          Command="{Binding Data.CopyScheduleCommand, Source={StaticResource ViewModelProxy}}"/>
                                                <MenuItem Header="设为活跃"
                                                          Command="{Binding Data.ActivateScheduleCommand, Source={StaticResource ViewModelProxy}}"
                                                          CommandParameter="{Binding Id}"/>
                                                <Separator/>
                                                <MenuItem Header="删除"
                                                          Command="{Binding Data.DeleteScheduleCommand, Source={StaticResource ViewModelProxy}}"/>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Stretch" Margin="8,6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Name}" Grid.Row="0" Grid.Column="0"
                                                   FontSize="14" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding UpdatedAt, Converter={StaticResource NotNullToVisibilityConverter}}">
                                            <Run Text="更新于 "/><Run Text="{Binding UpdatedAt, StringFormat={}{0:yyyy/MM/dd HH:mm}, Mode=OneWay}"/>
                                        </TextBlock>

                                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                Width="8" Height="8" CornerRadius="4"
                                                Background="{DynamicResource {x:Static ui:ThemeKeys.AccentFillColorDefaultBrushKey}}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Margin="4,0,0,0"
                                                ToolTip="此计划表处于活跃状态"
                                                Visibility="{Binding IsActivated, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- 第一个分隔条 -->
                    <GridSplitter Grid.Column="1"
                                  Width="6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="{DynamicResource {x:Static ui:ThemeKeys.ControlStrokeColorDefaultBrushKey}}"/>

                    <!-- 2. 右侧：时间段+时间点（无Tab） -->
                    <Grid Grid.Column="2" Background="{DynamicResource {x:Static ui:ThemeKeys.CardBackgroundFillColorDefaultBrushKey}}">

                        <!-- 空状态：未选中计划表时显示 -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding SelectedSchedule, Converter={StaticResource NullToVisibilityConverter}}">
                            <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Document_24_Regular}"
                                         FontSize="48"
                                         HorizontalAlignment="Center"
                                         Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}"/>
                            <TextBlock Text="请选择一个计划表"
                                       FontSize="16"
                                       Margin="0,16,0,4"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                            <TextBlock Text="从左侧列表选择或新建一个计划表以开始编辑"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}"/>
                        </StackPanel>

                        <!-- 编辑内容：选中计划表时显示 -->
                        <Grid Visibility="{Binding SelectedSchedule, Converter={StaticResource NotNullToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 右侧操作按钮 -->
                            <ui:CommandBar Grid.Row="0" DefaultLabelPosition="Right" Margin="4,4,4,0" HorizontalAlignment="Left">
                                <ui:AppBarButton Label="时间段" ToolTip="添加时间段" Command="{Binding AddTimeSegmentCommand}">
                                    <ui:AppBarButton.Icon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Add}"/>
                                    </ui:AppBarButton.Icon>
                                </ui:AppBarButton>
                                <ui:AppBarButton Label="时间点" ToolTip="添加时间点" Command="{Binding AddTimePointCommand}">
                                    <ui:AppBarButton.Icon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Add}"/>
                                    </ui:AppBarButton.Icon>
                                </ui:AppBarButton>
                                <ui:AppBarSeparator/>
                                <ui:AppBarButton Label="撤销" ToolTip="撤销" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}">
                                    <ui:AppBarButton.Icon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Undo}"/>
                                    </ui:AppBarButton.Icon>
                                </ui:AppBarButton>
                                <ui:AppBarButton Label="恢复" ToolTip="恢复" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}">
                                    <ui:AppBarButton.Icon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Redo}"/>
                                    </ui:AppBarButton.Icon>
                                </ui:AppBarButton>
                                <ui:AppBarSeparator/>
                                <ui:AppBarButton Label="删除" ToolTip="删除选中的项目" Command="{Binding DeleteScheduleItemCommand}">
                                    <ui:AppBarButton.Icon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Delete}"/>
                                    </ui:AppBarButton.Icon>
                                </ui:AppBarButton>
                                <ui:AppBarButton Label="排序" ToolTip="按时间重新排序" Command="{Binding RefreshOrderCommand}">
                                    <ui:AppBarButton.Icon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Sort}"/>
                                    </ui:AppBarButton.Icon>
                                </ui:AppBarButton>
                                <ui:AppBarSeparator/>
                                <ui:AppBarButton Label="信息" ToolTip="编辑计划表基本信息（暂未开放）" Command="{Binding EditScheduleInfoCommand}" IsEnabled="False">
                                    <ui:AppBarButton.Icon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Info}"/>
                                    </ui:AppBarButton.Icon>
                                </ui:AppBarButton>
                                <ui:AppBarButton Label="删除计划表" ToolTip="删除该计划表" Command="{Binding DeleteScheduleCommand}">
                                    <ui:AppBarButton.Icon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Delete}"/>
                                    </ui:AppBarButton.Icon>
                                </ui:AppBarButton>
                            </ui:CommandBar>

                        <!-- 右侧：列表+属性编辑 -->
                        <Grid Grid.Row="1" Background="{DynamicResource {x:Static ui:ThemeKeys.CardBackgroundFillColorSecondaryBrushKey}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="320" MinWidth="250" MaxWidth="450"/>
                            </Grid.ColumnDefinitions>

                            <!-- 列表区域（时间段+时间点） -->
                            <Grid Grid.Column="0">
                                <!-- 列表空状态：无项目时显示 -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                            Visibility="{Binding HasScheduleItems, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.TextBulletList_24_Regular}"
                                                 FontSize="36"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}"/>
                                    <TextBlock Text="暂无时间项目"
                                               FontSize="14"
                                               Margin="0,12,0,4"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                                    <TextBlock Text="点击上方按钮添加时间段或时间点"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}"/>
                                </StackPanel>

                                <!-- 列表 -->
                                <ListView Margin="4" ItemsSource="{Binding ScheduleItems}"
                                          SelectedItem="{Binding SelectedScheduleItem, Mode=TwoWay}"
                                          SelectionMode="Single"
                                          Visibility="{Binding HasScheduleItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalAlignment="Stretch" Margin="8,6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 类型指示条 -->
                                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                        Width="3" Margin="0,0,8,0"
                                                        CornerRadius="1.5">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource {x:Static ui:ThemeKeys.AccentFillColorDefaultBrushKey}}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ItemType}" Value="TimePoint">
                                                                    <Setter Property="Background" Value="{DynamicResource {x:Static ui:ThemeKeys.SystemFillColorCautionBrushKey}}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <!-- 上行：名称 -->
                                                <TextBlock Grid.Row="0" Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- 下行：时间范围 -->
                                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,0">
                                                    <!-- 时间段显示 -->
                                                    <TextBlock FontSize="11"
                                                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ItemType}" Value="TimePoint">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <Run Text="{Binding StartTime, Mode=OneWay}"/><Run Text=" – "/><Run Text="{Binding EndTime, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <!-- 时间点显示 -->
                                                    <TextBlock FontSize="11"
                                                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ItemType}" Value="TimePoint">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <Run Text="时间: "/><Run Text="{Binding StartTime, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>

                            <GridSplitter Grid.Column="1" Width="1"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="{DynamicResource {x:Static ui:ThemeKeys.ControlStrokeColorDefaultBrushKey}}"/>

                            <!-- 属性编辑 -->
                            <Grid Grid.Column="2">
                                <!-- 空状态：无选中项时显示 -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                            Visibility="{Binding SelectedScheduleItem, Converter={StaticResource NullToVisibilityConverter}}">
                                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Compose_24_Regular}"
                                                 FontSize="36"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}"/>
                                    <TextBlock Text="选择项目以编辑"
                                               FontSize="14"
                                               Margin="0,12,0,4"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                                    <TextBlock Text="从左侧列表选择一个时间段或时间点"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}"/>
                                </StackPanel>

                                <!-- 编辑面板：有选中项时显示 -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding SelectedScheduleItem, Converter={StaticResource NotNullToVisibilityConverter}}"
                                              Background="{DynamicResource {x:Static ui:ThemeKeys.CardBackgroundFillColorSecondaryBrushKey}}">
                                    <StackPanel Margin="16,12">

                                        <!-- 面板头部：动态类型标题 -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 时间段头部 -->
                                            <StackPanel Orientation="Horizontal" Grid.Column="0"
                                                        Visibility="{Binding IsSegmentSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border Width="4" Height="20" CornerRadius="2" Margin="0,0,8,0"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.AccentFillColorDefaultBrushKey}}"
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Text="编辑时间段" FontSize="16" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"/>
                                            </StackPanel>

                                            <!-- 时间点头部 -->
                                            <StackPanel Orientation="Horizontal" Grid.Column="0"
                                                        Visibility="{Binding IsTimePointSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border Width="4" Height="20" CornerRadius="2" Margin="0,0,8,0"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.SystemFillColorCautionBrushKey}}"
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Text="编辑时间点" FontSize="16" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 分隔线 -->
                                        <Border Height="1" Background="{DynamicResource {x:Static ui:ThemeKeys.ControlStrokeColorDefaultBrushKey}}" Margin="0,0,0,12"/>

                                        <!-- 分组：基本信息 -->
                                        <TextBlock Text="基本信息" FontSize="12" FontWeight="SemiBold"
                                                   Margin="0,0,0,8"
                                                   Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}"/>

                                        <TextBlock Text="名称" FontSize="12" Margin="0,0,0,4"
                                                   Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                                        <TextBox Text="{Binding SelectedScheduleItem.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                        <!-- 分组：时间设置 -->
                                        <TextBlock Text="时间设置" FontSize="12" FontWeight="SemiBold"
                                                   Margin="0,16,0,8"
                                                   Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}"/>

                                        <!-- 时间段：开始/结束时间并排 -->
                                        <Grid Visibility="{Binding IsSegmentSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Column="0" Text="开始时间" FontSize="12" Margin="0,0,0,4"
                                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                                            <TextBlock Grid.Column="2" Text="结束时间" FontSize="12" Margin="0,0,0,4"
                                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>

                                            <TextBox Grid.Column="0" Grid.Row="1"
                                                     Text="{Binding SelectedScheduleItem.StartTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox Grid.Column="2" Grid.Row="1"
                                                     Text="{Binding SelectedScheduleItem.EndTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                            <!-- 错误提示 -->
                                            <Border Grid.Column="0" Grid.Row="2" Margin="0,4,0,0"
                                                    Background="{DynamicResource {x:Static ui:ThemeKeys.SystemFillColorCriticalBackgroundBrushKey}}"
                                                    CornerRadius="4" Padding="8,4"
                                                    Visibility="{Binding SelectedScheduleItem.HasStartTimeError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding SelectedScheduleItem.StartTimeError}"
                                                           FontSize="11" Foreground="#C42B1C"
                                                           TextWrapping="Wrap"/>
                                            </Border>
                                            <Border Grid.Column="2" Grid.Row="2" Margin="0,4,0,0"
                                                    Background="{DynamicResource {x:Static ui:ThemeKeys.SystemFillColorCriticalBackgroundBrushKey}}"
                                                    CornerRadius="4" Padding="8,4"
                                                    Visibility="{Binding SelectedScheduleItem.HasEndTimeError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding SelectedScheduleItem.EndTimeError}"
                                                           FontSize="11" Foreground="#C42B1C"
                                                           TextWrapping="Wrap"/>
                                            </Border>
                                        </Grid>

                                        <!-- 时间点：时间+目标状态 -->
                                        <StackPanel Visibility="{Binding IsTimePointSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="时间" FontSize="12" Margin="0,0,0,4"
                                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                                            <TextBox Text="{Binding SelectedScheduleItem.StartTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Border Margin="0,4,0,0"
                                                    Background="{DynamicResource {x:Static ui:ThemeKeys.SystemFillColorCriticalBackgroundBrushKey}}"
                                                    CornerRadius="4" Padding="8,4"
                                                    Visibility="{Binding SelectedScheduleItem.HasStartTimeError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding SelectedScheduleItem.StartTimeError}"
                                                           FontSize="11" Foreground="#C42B1C"
                                                           TextWrapping="Wrap"/>
                                            </Border>

                                            <TextBlock Text="目标状态" FontSize="12" Margin="0,12,0,4"
                                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                                            <ComboBox ItemsSource="{Binding ToStateOptions}"
                                                      SelectedItem="{Binding SelectedScheduleItem.ToState, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"/>
                                        </StackPanel>

                                        <!-- 分组：样式 -->
                                        <TextBlock Text="样式" FontSize="12" FontWeight="SemiBold"
                                                   Margin="0,16,0,8"
                                                   Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}"/>

                                        <Expander IsExpanded="False" HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:ToggleSwitch IsOn="{Binding SelectedScheduleItem.HasCustomStyle, Mode=TwoWay}"
                                                                     OnContent="自定义样式" OffContent="默认样式"
                                                                     Margin="0,0,0,0"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel IsEnabled="{Binding SelectedScheduleItem.HasCustomStyle}"
                                                        Margin="0,4,0,0">

                                                <!-- 颜色预览 + 十六进制输入 -->
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40" Height="28" CornerRadius="4" Margin="0,0,8,0"
                                                            BorderBrush="{DynamicResource {x:Static ui:ThemeKeys.ControlStrokeColorDefaultBrushKey}}"
                                                            BorderThickness="1" VerticalAlignment="Center">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding SelectedScheduleItem.PreviewColor}"/>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding SelectedScheduleItem.HexColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- R -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="36"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="R" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                                                    <Slider Grid.Column="1" Margin="4,0"
                                                            Minimum="0" Maximum="255"
                                                            Value="{Binding SelectedScheduleItem.ForegroundR, Mode=TwoWay}"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding SelectedScheduleItem.ForegroundR, StringFormat={}{0:0}}"
                                                               FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}"/>
                                                </Grid>

                                                <!-- G -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="36"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="G" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                                                    <Slider Grid.Column="1" Margin="4,0"
                                                            Minimum="0" Maximum="255"
                                                            Value="{Binding SelectedScheduleItem.ForegroundG, Mode=TwoWay}"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding SelectedScheduleItem.ForegroundG, StringFormat={}{0:0}}"
                                                               FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}"/>
                                                </Grid>

                                                <!-- B -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="36"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="B" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                                                    <Slider Grid.Column="1" Margin="4,0"
                                                            Minimum="0" Maximum="255"
                                                            Value="{Binding SelectedScheduleItem.ForegroundB, Mode=TwoWay}"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding SelectedScheduleItem.ForegroundB, StringFormat={}{0:0}}"
                                                               FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}"/>
                                                </Grid>

                                                <!-- 透明度 -->
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="36"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="A" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"
                                                               ToolTip="透明度"/>
                                                    <Slider Grid.Column="1" Margin="4,0"
                                                            Minimum="0" Maximum="100"
                                                            Value="{Binding SelectedScheduleItem.Opacity, Mode=TwoWay}"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding SelectedScheduleItem.Opacity, StringFormat={}{0:0}%}"
                                                               FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorTertiaryBrushKey}}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Expander>

                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <ui:CommandBar Grid.Column="1"
                       VerticalAlignment="Top"
                       DefaultLabelPosition="Right"
                       IsOpen="False">
            <ui:AppBarButton Label="加载" Click="OnReloadButtonClick" RenderTransformOrigin="-0.822,0.675">
                <ui:AppBarButton.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.OpenFile}"/>
                </ui:AppBarButton.Icon>
            </ui:AppBarButton>
            <ui:AppBarButton Label="保存" Command="{Binding SaveCommand}" RenderTransformOrigin="-0.822,0.675">
                <ui:AppBarButton.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Save}"/>
                </ui:AppBarButton.Icon>
            </ui:AppBarButton>
        </ui:CommandBar>

        <!-- Toast 通知容器 -->
        <controls:ToastOverlay x:Name="ToastOverlayControl"
                               Grid.Column="0" Grid.ColumnSpan="2"
                               Margin="0,0,16,16"/>
    </Grid>

</Window>