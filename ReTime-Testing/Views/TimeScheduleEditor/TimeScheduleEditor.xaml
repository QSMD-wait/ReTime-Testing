<Window x:Class="ReTime_Testing.Views.TimeScheduleEditor.TimeScheduleEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReTime_Testing.Views.TimeScheduleEditor"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        mc:Ignorable="d"
        Title="时间计划表编辑器"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:TitleBar.Height="36"
        Width="1100"
        Height="700"
        MinWidth="800"
        MinHeight="500">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TabControl Grid.Column="0" Grid.ColumnSpan="2"
                    Style="{StaticResource TabControlPivotStyle}"
                    Padding="0">
            <!-- 预览选项 -->
            <TabItem Header="预览">
                <Grid Margin="16">
                    <TextBlock Text="预览区域 - 开发中"
                               FontSize="16"
                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </TabItem>

            <!-- 计划表选项 -->
            <TabItem Header="计划表">
                <!-- 根Grid：左侧列表 | 右侧Tab(时间段/时间点) -->
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" MinWidth="180" MaxWidth="400"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="500"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. 左侧面板：计划表列表 -->
                    <Grid Grid.Column="0" Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 左侧操作按钮 -->
                        <ui:CommandBar Grid.Row="0" DefaultLabelPosition="Right" Margin="4,4,4,0" HorizontalAlignment="Left">
                            <ui:AppBarButton Label="添加" ToolTip="新建计划表" Click="OnAddScheduleClick">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Add}"/>
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>
                            <ui:AppBarButton Label="复制" ToolTip="复制选中的计划表" Click="OnCopyScheduleClick">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Copy}"/>
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>
                        </ui:CommandBar>

                        <!-- 计划表列表 -->
                        <ListView Grid.Row="1" Margin="4" ItemsSource="{Binding Schedules}"
                                  SelectedItem="{Binding SelectedSchedule, Mode=TwoWay}"
                                  IsEnabled="True" SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Stretch" Margin="4">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <ui:FontIcon Glyph="&#xE4D2;" HorizontalAlignment="Right"
                                                       ToolTip="此计划表正在活动"
                                                       Visibility="Collapsed"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.AccentFillColorDefaultBrushKey}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- 第一个分隔条 -->
                    <GridSplitter Grid.Column="1"
                                  Width="6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="{DynamicResource {x:Static ui:ThemeKeys.ControlStrokeColorDefaultBrushKey}}"/>

                    <!-- 2. 右侧：时间段+时间点（无Tab） -->
                    <Grid Grid.Column="2" Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 右侧操作按钮 -->
                        <ui:CommandBar Grid.Row="0" DefaultLabelPosition="Right" Margin="4,4,4,0" HorizontalAlignment="Left">
                            <ui:AppBarButton Label="时间段" ToolTip="添加时间段" Click="OnAddTimeSegmentClick">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Add}"/>
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>
                            <ui:AppBarButton Label="时间点" ToolTip="添加时间点" Click="OnAddTimePointClick">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Add}"/>
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>
                            <ui:AppBarButton Label="删除" ToolTip="删除选中的项目" Click="OnDeleteScheduleItemClick">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Delete}"/>
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>
                            <ui:AppBarButton Label="刷新" ToolTip="重新排序" Click="OnRefreshOrderClick">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Refresh}"/>
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>

                            <ui:AppBarButton Label="计划表信息" ToolTip="编辑计划表基本信息（暂未开放）" Click="OnEditScheduleInfoClick" IsEnabled="False">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Info}"/>
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>
                            <ui:AppBarButton Label="删除计划表" ToolTip="删除该计划表" Click="OnDeleteScheduleClick">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Delete}"/>
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>
                        </ui:CommandBar>

                        <!-- 右侧：列表+属性编辑（无Tab） -->
                        <Grid Grid.Row="1" Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="320" MinWidth="250" MaxWidth="450"/>
                            </Grid.ColumnDefinitions>

                            <!-- 列表区域（时间段+时间点） -->
                            <ListView Grid.Column="0" Margin="4" ItemsSource="{Binding ScheduleItems}"
                                      SelectedItem="{Binding SelectedScheduleItem, Mode=TwoWay}"
                                      IsEnabled="True" SelectionMode="Single">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="8,4">
                                            <ui:FontIcon Glyph="{Binding TypeIcon}" FontSize="14" Margin="0,0,8,0"
                                                           Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                                            <TextBlock Text="{Binding Name}" Width="100" VerticalAlignment="Center"/>
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="{Binding StartTime}"/>
                                                <Run Text=" - "/>
                                                <Run Text="{Binding EndTime}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <GridSplitter Grid.Column="1" Width="6"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="{DynamicResource {x:Static ui:ThemeKeys.ControlStrokeColorDefaultBrushKey}}"/>

                            <!-- 属性编辑 -->
                            <Grid Grid.Column="2">
                                <!-- 空状态占位 -->
                                <TextBlock Text="请选择时间段或时间点进行编辑"
                                           Visibility="{Binding EmptyStateVisibility}"
                                           FontSize="14"
                                           Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <!-- 编辑面板 -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding EditPanelVisibility}"
                                              Background="{DynamicResource {x:Static ui:ThemeKeys.CardBackgroundFillColorSecondaryBrushKey}}">
                                    <StackPanel Margin="16">
                                        <TextBlock Text="编辑" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"/>

                                        <StackPanel Margin="0,16,0,0">
                                            <TextBlock Text="名称" FontSize="12" Margin="0,0,0,4"
                                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                                            <TextBox Text="{Binding SelectedScheduleItem.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     LostFocus="OnItemNameLostFocus"/>
                                        </StackPanel>

                                        <!-- 时间段专用：开始时间+结束时间 -->
                                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsSegmentSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="开始时间" FontSize="12" Margin="0,0,0,4"
                                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                                            <TextBox Text="{Binding SelectedScheduleItem.StartTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="OnTimeTextChanged"/>
                                            <TextBlock Text="{Binding SelectedScheduleItem.StartTimeError}"
                                                       FontSize="11" Foreground="#C42B1C" Margin="0,2,0,0"
                                                       Visibility="{Binding SelectedScheduleItem.HasStartTimeError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>

                                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsSegmentSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="结束时间" FontSize="12" Margin="0,0,0,4"
                                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                                            <TextBox Text="{Binding SelectedScheduleItem.EndTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="OnTimeTextChanged"/>
                                            <TextBlock Text="{Binding SelectedScheduleItem.EndTimeError}"
                                                       FontSize="11" Foreground="#C42B1C" Margin="0,2,0,0"
                                                       Visibility="{Binding SelectedScheduleItem.HasEndTimeError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>

                                        <!-- 时间点专用：时间+目标状态 -->
                                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsTimePointSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="时间" FontSize="12" Margin="0,0,0,4"
                                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                                            <TextBox Text="{Binding SelectedScheduleItem.StartTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="OnTimeTextChanged"/>
                                            <TextBlock Text="{Binding SelectedScheduleItem.StartTimeError}"
                                                       FontSize="11" Foreground="#C42B1C" Margin="0,2,0,0"
                                                       Visibility="{Binding SelectedScheduleItem.HasStartTimeError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>

                                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsTimePointSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="目标状态" FontSize="12" Margin="0,0,0,4"
                                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                                            <ComboBox ItemsSource="{Binding ToStateOptions}"
                                                      SelectedItem="{Binding SelectedScheduleItem.ToState, Mode=TwoWay}"/>
                                        </StackPanel>

                                        <!-- 样式编辑区域 -->
                                        <Expander Header="样式" Margin="0,16,0,0" IsExpanded="False">
                                            <StackPanel>
                                                <!-- 开关：启用自定义样式 -->
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                                                    <ui:ToggleSwitch IsOn="{Binding SelectedScheduleItem.HasCustomStyle, Mode=TwoWay}"
                                                                     OnContent="启用样式" OffContent="默认样式"/>
                                                </StackPanel>

                                                <!-- 样式编辑内容 -->
                                                <Grid IsEnabled="{Binding SelectedScheduleItem.HasCustomStyle}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="55"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                <!-- R -->
                                                <TextBlock Text="R" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Grid.Row="0" Margin="4,0,8,0"
                                                        Minimum="0" Maximum="255"
                                                        Value="{Binding SelectedScheduleItem.ForegroundR, Mode=TwoWay}"
                                                        ValueChanged="OnStyleValueChanged"/>
                                                <TextBlock Grid.Column="2" Grid.Row="0"
                                                           Text="{Binding SelectedScheduleItem.ForegroundR, StringFormat={}{0:0}}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                                <!-- G -->
                                                <TextBlock Text="G" Grid.Row="1" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Grid.Row="1" Margin="4,0,8,0"
                                                        Minimum="0" Maximum="255"
                                                        Value="{Binding SelectedScheduleItem.ForegroundG, Mode=TwoWay}"
                                                        ValueChanged="OnStyleValueChanged"/>
                                                <TextBlock Grid.Column="2" Grid.Row="1"
                                                           Text="{Binding SelectedScheduleItem.ForegroundG, StringFormat={}{0:0}}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                                <!-- B -->
                                                <TextBlock Text="B" Grid.Row="2" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Grid.Row="2" Margin="4,0,8,0"
                                                        Minimum="0" Maximum="255"
                                                        Value="{Binding SelectedScheduleItem.ForegroundB, Mode=TwoWay}"
                                                        ValueChanged="OnStyleValueChanged"/>
                                                <TextBlock Grid.Column="2" Grid.Row="2"
                                                           Text="{Binding SelectedScheduleItem.ForegroundB, StringFormat={}{0:0}}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                                <!-- 透明度 -->
                                                <TextBlock Text="透明度" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Slider Grid.Column="1" Grid.Row="3" Margin="4,0,8,0"
                                                        Minimum="0" Maximum="100"
                                                        Value="{Binding SelectedScheduleItem.Opacity, Mode=TwoWay}"
                                                        ValueChanged="OnStyleValueChanged"/>
                                                <TextBlock Grid.Column="2" Grid.Row="3"
                                                           Text="{Binding SelectedScheduleItem.Opacity, StringFormat={}{0:0}%}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                                <!-- 颜色预览 + 十六进制输入 -->
                                                <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0">
                                                    <Border Width="48" Height="28" BorderBrush="Gray" BorderThickness="1" Margin="0,0,12,0">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding SelectedScheduleItem.PreviewColor}"/>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBox Width="90"
                                                             Text="{Binding SelectedScheduleItem.HexColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             VerticalAlignment="Center"
                                                             LostFocus="OnItemNameLostFocus"/>
                                                </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <ui:CommandBar Grid.Column="1"
                       VerticalAlignment="Top"
                       DefaultLabelPosition="Right"
                       IsOpen="False">
            <ui:AppBarButton Label="加载" Click="OnReloadButtonClick" RenderTransformOrigin="-0.822,0.675">
                <ui:AppBarButton.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.OpenFile}"/>
                </ui:AppBarButton.Icon>
            </ui:AppBarButton>
            <ui:AppBarButton Label="保存" Click="OnSaveButtonClick" RenderTransformOrigin="-0.822,0.675">
                <ui:AppBarButton.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Save}"/>
                </ui:AppBarButton.Icon>
            </ui:AppBarButton>
        </ui:CommandBar>

        <!-- 保存时验证失败的 InfoBar -->
        <ui:InfoBar x:Name="SaveValidationInfoBar"
                    Grid.Column="0" Grid.ColumnSpan="2"
                    Title="验证失败"
                    IsOpen="False"
                    Severity="Error"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Right"
                    Margin="0,0,16,16"/>
    </Grid>

</Window>