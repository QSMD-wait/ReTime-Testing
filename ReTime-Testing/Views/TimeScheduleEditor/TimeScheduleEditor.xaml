                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Margin="4,0,0,0"
                                                ToolTip="此组处于激活状态"
                                                Visibility="{Binding IsActivated, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
