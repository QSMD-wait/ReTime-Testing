<Window x:Class="ReTime_Testing.Views.TimeScheduleEditor.TimeScheduleEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReTime_Testing.Views.TimeScheduleEditor"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        mc:Ignorable="d"
        Title="时间计划表编辑器"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:TitleBar.Height="36"
        Width="1100"
        Height="700"
        MinWidth="800"
        MinHeight="500">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TabControl Grid.Column="0" Grid.ColumnSpan="2"
                    Style="{StaticResource TabControlPivotStyle}">
            <!-- 预览选项 -->
            <TabItem Header="预览">
                <Grid Margin="16">
                    <TextBlock Text="预览区域 - 开发中"
                               FontSize="16"
                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </TabItem>

            <!-- 计划表选项 -->
            <TabItem Header="计划表">
                <!-- 根Grid，用于实现嵌套布局 -->
                <Grid>
                    <!-- 外层Grid定义：左侧列表 | 分隔条 | 右侧所有内容 -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" MinWidth="180" MaxWidth="400"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="320" MinWidth="250" MaxWidth="450"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. 左侧面板：计划表列表 -->
                    <Grid Grid.Column="0" Background="{DynamicResource {x:Static ui:ThemeKeys.CardBackgroundFillColorDefaultBrushKey}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 操作按钮 -->
                        <ui:CommandBar Grid.Row="0" DefaultLabelPosition="Right" Margin="4,4,4,0">
                            <ui:AppBarButton Label="添加" ToolTip="新建计划表" Click="OnAddScheduleClick">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Add}"/>
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>
                            <ui:AppBarButton Label="复制" ToolTip="复制选中的计划表" Click="OnCopyScheduleClick">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Copy}"/>
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>
                        </ui:CommandBar>

                        <!-- 计划表列表 -->
                        <ListView Grid.Row="1" Margin="4" ItemsSource="{Binding Schedules}"
                                  SelectedItem="{Binding SelectedSchedule, Mode=TwoWay}"
                                  IsEnabled="True" SelectionMode="Single"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Stretch" Margin="4">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <ui:FontIcon Glyph="&#xE4D2;" HorizontalAlignment="Right"
                                                       ToolTip="此计划表正在活动"
                                                       Visibility="Collapsed"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.AccentFillColorDefaultBrushKey}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- 第一个分隔条 -->
                    <GridSplitter Grid.Column="1"
                                  Width="6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="{DynamicResource {x:Static ui:ThemeKeys.ControlStrokeColorDefaultBrushKey}}"/>

                    <!-- 2. 中间编辑区 -->
                    <Grid Grid.Column="2" Background="{DynamicResource {x:Static ui:ThemeKeys.CardBackgroundFillColorSecondaryBrushKey}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 操作按钮 -->
                        <ui:CommandBar Grid.Row="0" DefaultLabelPosition="Right" Margin="4,4,4,0">
                            <ui:AppBarButton Label="时间段" ToolTip="添加时间段" Click="OnAddTimeSegmentClick">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Add}"/>
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>
                            <ui:AppBarButton Label="时间点" ToolTip="添加时间点" Click="OnAddTimePointClick">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Airplane}"/>
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>

                            <ui:AppBarButton Label="删除" ToolTip="删除选中的时间段或时间点" Click="OnDeleteScheduleItemClick">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Delete}"/>
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>
                            <ui:AppBarButton Label="刷新" ToolTip="重新排序" Click="OnRefreshOrderClick">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Refresh}"/>
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>

                            <ui:AppBarButton Label="计划表信息" ToolTip="编辑计划表基本信息" Click="OnEditScheduleInfoClick">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Info}"/>
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>
                            <ui:AppBarButton Label="删除计划表" ToolTip="删除该计划表" Click="OnDeleteScheduleClick">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Delete}"/>
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>
                        </ui:CommandBar>

                        <!-- 时间段/时间点列表 -->
                        <ListView Grid.Row="1" Margin="4" ItemsSource="{Binding ScheduleItems}"
                                  IsEnabled="True" SelectionMode="Single"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="8,4">
                                        <!-- 类型图标 -->
                                        <ui:FontIcon Glyph="{Binding TypeIcon}" FontSize="14" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                                        <!-- 名称 -->
                                        <TextBlock Text="{Binding Name}" Width="80" VerticalAlignment="Center"/>
                                        <!-- 时间范围 -->
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{Binding StartTime}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding EndTime}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- 第二个分隔条 -->
                    <GridSplitter Grid.Column="3"
                                  Width="6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="{DynamicResource {x:Static ui:ThemeKeys.ControlStrokeColorDefaultBrushKey}}"/>

                    <!-- 3. 右侧属性区 -->
                    <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto"
                                  Background="{DynamicResource {x:Static ui:ThemeKeys.CardBackgroundFillColorSecondaryBrushKey}}">
                        <StackPanel Margin="16">
                            <!-- 标题 -->
                            <TextBlock Text="时间段/时间点编辑" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"/>

                            <!-- 名称 -->
                            <StackPanel Margin="0,16,0,0">
                                <TextBlock Text="名称" FontSize="12" Margin="0,0,0,4"
                                           Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                                <TextBox Text="上午工作"/>
                            </StackPanel>

                            <!-- 开始时间 -->
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="开始时间" FontSize="12" Margin="0,0,0,4"
                                           Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                                <TextBox Text="09:00:00"/>
                            </StackPanel>

                            <!-- 结束时间 -->
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="结束时间" FontSize="12" Margin="0,0,0,4"
                                           Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                                <TextBox Text="12:00:00"/>
                            </StackPanel>

                            <!-- 类型 -->
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="类型" FontSize="12" Margin="0,0,0,4"
                                           Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                                <ComboBox SelectedIndex="0">
                                    <ComboBoxItem Content="时间段"/>
                                    <ComboBoxItem Content="时间点"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- 分隔线 -->
                            <Separator Margin="0,16,0,16" Background="{DynamicResource {x:Static ui:ThemeKeys.ControlStrokeColorDefaultBrushKey}}"/>

                            <!-- 描述 -->
                            <StackPanel>
                                <TextBlock Text="描述" FontSize="12" Margin="0,0,0,4"
                                           Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"/>
                                <TextBox Text="上午的工作时间段"
                                            TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <ui:CommandBar Grid.Column="1"
                       VerticalAlignment="Top"
                       DefaultLabelPosition="Right"
                       IsOpen="False">
            <ui:AppBarButton Label="保存" Click="OnSaveButtonClick" RenderTransformOrigin="-0.822,0.675">
                <ui:AppBarButton.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Save}"/>
                </ui:AppBarButton.Icon>
            </ui:AppBarButton>
        </ui:CommandBar>
    </Grid>

</Window>