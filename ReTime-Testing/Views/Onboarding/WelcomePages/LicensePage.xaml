<UserControl x:Class="ReTime_Testing.Views.Onboarding.WelcomePages.LicensePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="840">

    <UserControl.Resources>
        <sys:Double x:Key="CheckBoxBorderThemeThickness">0</sys:Double>
    </UserControl.Resources>

    <Grid>
        <ikw:SimpleStackPanel Margin="170,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Spacing="8">

            <TextBlock Text="许可协议"
                       FontSize="26"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <TextBlock Text="ReTime - Testing 是一款开源软件，源代码向所有人开放。"
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <TextBlock Text="Copyright © 2025-2026 青色漫地_wait"
                       FontSize="13"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>

            <TextBlock FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,0">
                本应用基于 <Run FontWeight="SemiBold">GNU General Public License v3.0</Run>（GPLv3）授权发布
            </TextBlock>

            <ikw:SimpleStackPanel Spacing="4" Margin="0,8,0,0">
                <TextBlock Text="• 你可以自由地使用、学习和修改本应用"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="• 你可以再分发本应用，但须同样以 GPLv3 协议开源"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="• 本应用不提供任何担保，详见许可证全文"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </ikw:SimpleStackPanel>

            <ikw:SimpleStackPanel Orientation="Horizontal"
                         HorizontalAlignment="Center"
                         Spacing="4"
                         Margin="0,8,0,0">
                <TextBlock Text="项目仓库：" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <ui:HyperlinkButton Content="https://github.com/QSMD-wait/ReTime-Testing"
                                    Padding="0"
                                    Click="OnOpenRepositoryClick"/>
            </ikw:SimpleStackPanel>

            <CheckBox Content="我已阅读并同意上述许可协议"
                      IsChecked="{Binding HasAcceptedLicense, Mode=TwoWay}"
                      HorizontalAlignment="Center"
                      Margin="0,16,0,0"/>
        </ikw:SimpleStackPanel>
    </Grid>
</UserControl>
