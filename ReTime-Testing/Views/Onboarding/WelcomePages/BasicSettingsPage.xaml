<UserControl x:Class="ReTime_Testing.Views.Onboarding.WelcomePages.BasicSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="840">

    <Grid>
        <ikw:SimpleStackPanel Margin="170,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Spacing="4">

            <TextBlock Text="基本设置"
                       FontSize="26"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock Text="配置应用的启动方式与时间同步，所有选项之后都可以在设置窗口中随时修改。"
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,24"/>

            <ui:SettingsCard Header="开机自动运行"
                             Description="在系统启动时自动运行应用"
                             HorizontalAlignment="Stretch">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ArrowRepeatAll_24_Regular}" />
                </ui:SettingsCard.HeaderIcon>
                <ui:ToggleSwitch IsOn="{Binding EnableAutoStart, Mode=TwoWay}"
                                 OffContent="关闭"
                                 OnContent="开启"
                                 MinWidth="0"/>
            </ui:SettingsCard>

            <ui:SettingsCard Header="云端时间校准"
                             Description="定期与云端时间源（NTP）同步，确保进度计算准确，建议开启"
                             HorizontalAlignment="Stretch">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ClockToolbox_24_Regular}" />
                </ui:SettingsCard.HeaderIcon>
                <ui:ToggleSwitch IsOn="{Binding EnableCalibration, Mode=TwoWay}"
                                 OffContent="关闭"
                                 OnContent="开启"
                                 MinWidth="0"/>
            </ui:SettingsCard>
        </ikw:SimpleStackPanel>
    </Grid>
</UserControl>
