<UserControl x:Class="ReTime_Testing.Views.Onboarding.WelcomePages.ThemePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:ReTime_Testing.Helpers"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="840">

    <UserControl.Resources>
        <helpers:StringEqualsConverter x:Key="StringEqualsConverter"/>
    </UserControl.Resources>

    <Grid>
        <ikw:SimpleStackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="4">

            <TextBlock Text="选择应用主题"
                       FontSize="26"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock Text="在浅色与深色之间选择您喜欢的界面外观，切换会立即生效。"
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,24"/>

            <UniformGrid Columns="2" Rows="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                <!-- 浅色主题卡片 -->
                <RadioButton GroupName="WelcomeTheme"
                             IsChecked="{Binding SelectedTheme, Converter={StaticResource StringEqualsConverter}, ConverterParameter=light}"
                             Width="220"
                             Margin="8"
                             Padding="12">
                    <StackPanel>
                        <TextBlock Text="明亮"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <Border Width="180" Height="84" CornerRadius="8"
                                Background="#F2F2F2"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1">
                            <Grid>
                                <Border Width="140" Height="34" CornerRadius="4"
                                        Background="#FFFFFF"
                                        BorderBrush="#D0D0D0"
                                        BorderThickness="1"
                                        VerticalAlignment="Top" Margin="20,14,0,0"/>
                                <Border Width="100" Height="10" CornerRadius="5"
                                        Background="#0078D4"
                                        VerticalAlignment="Bottom" Margin="20,0,0,10"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </RadioButton>

                <!-- 深色主题卡片 -->
                <RadioButton GroupName="WelcomeTheme"
                             IsChecked="{Binding SelectedTheme, Converter={StaticResource StringEqualsConverter}, ConverterParameter=dark}"
                             Width="220"
                             Margin="8"
                             Padding="12">
                    <StackPanel>
                        <TextBlock Text="暗黑"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <Border Width="180" Height="84" CornerRadius="8"
                                Background="#1B1B1F"
                                BorderBrush="#3A3A3F"
                                BorderThickness="1">
                            <Grid>
                                <Border Width="140" Height="34" CornerRadius="4"
                                        Background="#2B2B30"
                                        BorderBrush="#3A3A3F"
                                        BorderThickness="1"
                                        VerticalAlignment="Top" Margin="20,14,0,0"/>
                                <Border Width="100" Height="10" CornerRadius="5"
                                        Background="#4CC2FF"
                                        VerticalAlignment="Bottom" Margin="20,0,0,10"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <TextBlock Text="选中后界面将立即切换主题预览。"
                       FontSize="12"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        </ikw:SimpleStackPanel>
    </Grid>
</UserControl>