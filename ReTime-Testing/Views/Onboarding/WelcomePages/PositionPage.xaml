<UserControl x:Class="ReTime_Testing.Views.Onboarding.WelcomePages.PositionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:ReTime_Testing.Helpers"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="840">

    <UserControl.Resources>
        <helpers:StringEqualsConverter x:Key="StringEqualsConverter"/>
    </UserControl.Resources>

    <Grid>
        <ikw:SimpleStackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="4">

            <TextBlock Text="选择进度条位置"
                       FontSize="26"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock Text="进度条将贴在屏幕边缘显示，选择时桌面窗口会实时移动预览。"
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,20"/>

            <UniformGrid Columns="2" Rows="2" HorizontalAlignment="Center" Margin="0,0,0,12">
                <!-- 顶部 -->
                <RadioButton GroupName="WelcomePosition"
                             IsChecked="{Binding SelectedPosition, Converter={StaticResource StringEqualsConverter}, ConverterParameter=top}"
                             Width="220"
                             Margin="6"
                             Padding="10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="92" Height="52" CornerRadius="6"
                                Background="#CCE3F5"
                                BorderBrush="#8FBFE8"
                                BorderThickness="1">
                            <Border Width="92" Height="9" CornerRadius="3"
                                    Background="#0078D4"
                                    VerticalAlignment="Top"/>
                        </Border>
                        <TextBlock Text="顶部"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                </RadioButton>

                <!-- 底部 -->
                <RadioButton GroupName="WelcomePosition"
                             IsChecked="{Binding SelectedPosition, Converter={StaticResource StringEqualsConverter}, ConverterParameter=bottom}"
                             Width="220"
                             Margin="6"
                             Padding="10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="92" Height="52" CornerRadius="6"
                                Background="#CCE3F5"
                                BorderBrush="#8FBFE8"
                                BorderThickness="1">
                            <Border Width="92" Height="9" CornerRadius="3"
                                    Background="#0078D4"
                                    VerticalAlignment="Bottom"/>
                        </Border>
                        <TextBlock Text="底部"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                </RadioButton>

                <!-- 左侧 -->
                <RadioButton GroupName="WelcomePosition"
                             IsChecked="{Binding SelectedPosition, Converter={StaticResource StringEqualsConverter}, ConverterParameter=left}"
                             Width="220"
                             Margin="6"
                             Padding="10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="92" Height="52" CornerRadius="6"
                                Background="#CCE3F5"
                                BorderBrush="#8FBFE8"
                                BorderThickness="1">
                            <Border Width="9" Height="52" CornerRadius="3"
                                    Background="#0078D4"
                                    HorizontalAlignment="Left"/>
                        </Border>
                        <TextBlock Text="左侧"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                </RadioButton>

                <!-- 右侧 -->
                <RadioButton GroupName="WelcomePosition"
                             IsChecked="{Binding SelectedPosition, Converter={StaticResource StringEqualsConverter}, ConverterParameter=right}"
                             Width="220"
                             Margin="6"
                             Padding="10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="92" Height="52" CornerRadius="6"
                                Background="#CCE3F5"
                                BorderBrush="#8FBFE8"
                                BorderThickness="1">
                            <Border Width="9" Height="52" CornerRadius="3"
                                    Background="#0078D4"
                                    HorizontalAlignment="Right"/>
                        </Border>
                        <TextBlock Text="右侧"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <TextBlock Text="此设置可在「设置 → 窗口」中随时调整。"
                       FontSize="12"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        </ikw:SimpleStackPanel>
    </Grid>
</UserControl>