<UserControl x:Class="ReTime_Testing.Views.Onboarding.WelcomePages.AppearanceSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="840">

    <Grid>
        <ikw:SimpleStackPanel Margin="170,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Spacing="4">

            <TextBlock Text="外观设置"
                       FontSize="26"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock Text="调整进度条的外观与流畅度，改动会实时预览。"
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,24"/>

            <ui:SettingsCard Header="进度条缩放"
                             Description="调整进度条的整体大小"
                             HorizontalAlignment="Stretch">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Resize_24_Regular}" />
                </ui:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal">
                    <Slider Value="{Binding ProgressScale, Mode=TwoWay}"
                            Minimum="0.5" Maximum="3.0"
                            TickFrequency="0.1"
                            IsSnapToTickEnabled="True"
                            Width="160"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ProgressScale, StringFormat={}{0:F1}x}"
                               Width="40"
                               TextAlignment="Center"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </ui:SettingsCard>

            <ui:SettingsCard Header="进度条阴影效果"
                             Description="为进度条添加阴影，增强层次感"
                             HorizontalAlignment="Stretch">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Sparkle_24_Regular}" />
                </ui:SettingsCard.HeaderIcon>
                <ui:ToggleSwitch IsOn="{Binding EnableProgressShadow, Mode=TwoWay}"
                                 OffContent="关闭"
                                 OnContent="开启"
                                 MinWidth="0"/>
            </ui:SettingsCard>

            <ui:SettingsCard Header="流畅优化"
                             Description="优化渲染流畅度，低帧率设备建议开启"
                             HorizontalAlignment="Stretch">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Rocket_24_Regular}" />
                </ui:SettingsCard.HeaderIcon>
                <ui:ToggleSwitch IsOn="{Binding EnableSmoothness, Mode=TwoWay}"
                                 OffContent="关闭"
                                 OnContent="开启"
                                 MinWidth="0"/>
            </ui:SettingsCard>
        </ikw:SimpleStackPanel>
    </Grid>
</UserControl>
