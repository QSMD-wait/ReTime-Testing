<UserControl x:Class="ReTime_Testing.Views.Onboarding.WelcomePages.TextOverlaySettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="840">

    <Grid>
        <ikw:SimpleStackPanel Margin="170,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Spacing="4">

            <TextBlock Text="文字栏设置"
                       FontSize="26"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock Text="配置进度条上的文字信息栏，改动会实时预览。"
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,24"/>

            <ui:SettingsCard Header="启用文字栏"
                             Description="在进度条上显示时间、剩余时间等文字信息"
                             HorizontalAlignment="Stretch">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.TextDescription_24_Regular}" />
                </ui:SettingsCard.HeaderIcon>
                <ui:ToggleSwitch IsOn="{Binding EnableTextOverlay, Mode=TwoWay}"
                                 OffContent="关闭"
                                 OnContent="开启"
                                 MinWidth="0"/>
            </ui:SettingsCard>

            <ui:SettingsCard Header="文字大小"
                             Description="调整文字栏的全局字体大小"
                             HorizontalAlignment="Stretch">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.TextFontSize_24_Regular}" />
                </ui:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal">
                    <Slider Value="{Binding TextFontSize, Mode=TwoWay}"
                            Minimum="6" Maximum="48"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Width="160"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TextFontSize, StringFormat={}{0:F0}px}"
                               Width="40"
                               TextAlignment="Center"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </ui:SettingsCard>

            <ui:SettingsCard Header="文字效果"
                             Description="文字的字体效果样式"
                             HorizontalAlignment="Stretch">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.TextFont_24_Regular}" />
                </ui:SettingsCard.HeaderIcon>
                <ComboBox SelectedValue="{Binding SelectedTextEffect, Mode=TwoWay}"
                          SelectedValuePath="Tag"
                          MinWidth="120">
                    <ComboBoxItem Content="无效果" Tag="none"/>
                    <ComboBoxItem Content="阴影" Tag="shadow"/>
                    <ComboBoxItem Content="描边" Tag="outline"/>
                </ComboBox>
            </ui:SettingsCard>
        </ikw:SimpleStackPanel>
    </Grid>
</UserControl>
