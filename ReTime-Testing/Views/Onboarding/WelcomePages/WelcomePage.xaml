<UserControl x:Class="ReTime_Testing.Views.Onboarding.WelcomePages.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="840">

    <Grid>
        <ikw:SimpleStackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="4">

            <Image Source="pack://application:,,,/ReTime-Testing;component/Resources/app.png"
                   Width="96"
                   Height="96"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16"/>

            <TextBlock Text="ReTime - Testing"
                       FontSize="26"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>

            <TextBlock x:Name="VersionText"
                       Text="版本 0.0.0"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </ikw:SimpleStackPanel>
    </Grid>
</UserControl>
