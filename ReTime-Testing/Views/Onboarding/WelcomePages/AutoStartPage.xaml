<UserControl x:Class="ReTime_Testing.Views.Onboarding.WelcomePages.AutoStartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="840">

    <Grid>
        <ikw:SimpleStackPanel Margin="170,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Spacing="4">

            <TextBlock Text="开机自启"
                       FontSize="26"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock Text="开启后，ReTime 将在您登录 Windows 时自动启动，进度条时刻就绪。"
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,24"/>

            <ui:SettingsCard Header="开机自动运行"
                             Description="在系统启动时自动运行应用"
                             HorizontalAlignment="Stretch">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ArrowRepeatAll_24_Regular}" />
                </ui:SettingsCard.HeaderIcon>
                <ui:ToggleSwitch IsOn="{Binding EnableAutoStart, Mode=TwoWay}"
                                 OffContent="关闭"
                                 OnContent="开启"
                                 MinWidth="0"/>
            </ui:SettingsCard>

            <TextBlock Text="此设置可在「设置 → 基本」中随时调整。"
                       FontSize="12"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,16,0,0"/>
        </ikw:SimpleStackPanel>
    </Grid>
</UserControl>