<UserControl x:Class="ReTime_Testing.Views.Controls.SettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ReTime_Testing.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="80" d:DesignWidth="600">

    <Border x:Name="CardBorder"
            Background="#F9F9F9"
            CornerRadius="6"
            Padding="16,12"
            Margin="0,0,0,6"
            BorderBrush="#E0E0E0"
            BorderThickness="1">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 第1列：图标 -->
            <TextBlock x:Name="IconTextBlock"
                       Grid.Column="0"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="18"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Foreground="#333333"/>

            <!-- 第2列：标题和描述 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleTextBlock"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="Black"/>
                <TextBlock x:Name="DescriptionTextBlock"
                           FontSize="11"
                           Foreground="Gray"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 第3列：交互控件 -->
            <ContentPresenter x:Name="ContentPresenter"
                              Grid.Column="2"
                              VerticalAlignment="Center"
                              Content="{Binding ControlContent, RelativeSource={RelativeSource AncestorType=local:SettingsCard}}"/>
        </Grid>
    </Border>
</UserControl>