<Window x:Class="ReTime_Testing.Views.TimeTopDesktop.TimeTopDesktop_Left"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReTime_Testing.Views.TimeTopDesktop"
        xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:helpers="clr-namespace:ReTime_Testing.Helpers"
        mc:Ignorable="d"
        Title="TimeTopDesktop.Left">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <helpers:BooleanToEffectConverter x:Key="BooleanToEffectConverter"/>
    </Window.Resources>

    <!-- 整体逆时针旋转90°：水平布局→垂直，进度条底→顶填充 -->
    <Grid>
        <Grid.LayoutTransform>
            <RotateTransform Angle="-90"/>
        </Grid.LayoutTransform>

        <ui:ProgressBar x:Name="ProgressBar" VerticalAlignment="Top" Height="5" Margin="0,-1,0,0"
                       Value="{Binding ProgressValue}"
                       IsIndeterminate="{Binding IsIndeterminate}"
                       Foreground="{Binding Foreground, FallbackValue=Transparent}"
                       Background="{Binding Background, FallbackValue=Transparent}"
                       Visibility="{Binding Visibility}"
                       IsEnabled="{Binding IsEnabled}"
                       Opacity="{Binding Opacity}"
                       Minimum="{Binding Minimum}"
                       Maximum="{Binding Maximum}">
            <ui:ProgressBar.Effect>
                <Binding Path="EnableShadow" Converter="{StaticResource BooleanToEffectConverter}">
                    <Binding.ConverterParameter>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="8" Color="Black" Opacity="0.3"/>
                    </Binding.ConverterParameter>
                </Binding>
            </ui:ProgressBar.Effect>
        </ui:ProgressBar>

        <local:PriorityTextOverlayPanel
              VerticalAlignment="Top"
              Margin="0,7,0,0"
              Height="18"
              Visibility="{Binding TextOverlay.IsVisible, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"
              LeftSlots="{Binding TextOverlay.LeftSlots}"
              CenterSlots="{Binding TextOverlay.CenterSlots}"
              RightSlots="{Binding TextOverlay.RightSlots}"
              StyleConfig="{Binding TextOverlay.Style}"/>
    </Grid>

</Window>