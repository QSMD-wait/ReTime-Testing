<Window x:Class="ReTime_Testing.Views.TimeTopDesktop.TimeTopDesktop"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReTime_Testing.Views.TimeTopDesktop"
        xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:vm="clr-namespace:ReTime_Testing.ViewModels"
        mc:Ignorable="d"
        Title="TimeTopDesktop">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <ui:ProgressBar x:Name="ProgressBar" VerticalAlignment="Top" Height="5" Margin="0,-1,0,0"
                       Value="{Binding ProgressValue}"
                       IsIndeterminate="{Binding IsIndeterminate}"
                       Foreground="{Binding Foreground, FallbackValue=Transparent}"
                       Background="{Binding Background, FallbackValue=Transparent}"
                       Visibility="{Binding Visibility}"
                       IsEnabled="{Binding IsEnabled}"
                       Opacity="{Binding Opacity}"
                       Minimum="{Binding Minimum}"
                       Maximum="{Binding Maximum}">
            <ui:ProgressBar.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Color="Black" Opacity="0.3"/>
            </ui:ProgressBar.Effect>
        </ui:ProgressBar>

        <!-- 文字覆盖条 -->
        <Grid x:Name="TextOverlayPanel"
              VerticalAlignment="Top"
              Margin="0,7,0,0"
              Height="18"
              Visibility="{Binding TextOverlay.IsVisible, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
            
            <!-- 左侧文字（左对齐） -->
            <ItemsControl HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding TextOverlay.LeftSlots}"
                          Margin="10,0,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TextSlotDisplay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Text}" Foreground="White" FontSize="12" Opacity="0.8"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Separator}" Foreground="White" FontSize="12" Opacity="0.4"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 中间文字（绝对居中） -->
            <ItemsControl HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding TextOverlay.CenterSlots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TextSlotDisplay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Text}" Foreground="White" FontSize="12" Opacity="0.8"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Separator}" Foreground="White" FontSize="12" Opacity="0.4"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 右侧文字（右对齐） -->
            <ItemsControl HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding TextOverlay.RightSlots}"
                          Margin="0,0,10,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TextSlotDisplay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Text}" Foreground="White" FontSize="12" Opacity="0.8"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Separator}" Foreground="White" FontSize="12" Opacity="0.4"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>

</Window>