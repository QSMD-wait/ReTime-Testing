<Window x:Class="ReTime_Testing.Views.TimeTopDesktop.TimeTopDesktop"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReTime_Testing.Views.TimeTopDesktop"
        xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        mc:Ignorable="d"
        Title="TimeTopDesktop"> 

    <Grid IsHitTestVisible="False">
        <ui:ProgressBar x:Name="ProgressBar" VerticalAlignment="Top" Height="5" Margin="0,-1,0,0"
                       Value="{Binding ProgressValue}"
                       IsIndeterminate="{Binding IsIndeterminate}"
                       Foreground="{Binding Foreground, FallbackValue=Transparent}"
                       Background="{Binding Background, FallbackValue=Transparent}"
                       Visibility="{Binding Visibility}"
                       IsEnabled="{Binding IsEnabled}"
                       Opacity="{Binding Opacity}"
                       Minimum="{Binding Minimum}"
                       Maximum="{Binding Maximum}" />
        <TextBlock x:Name="TestText" Text="ReTime - Testing  //  v0.0.1-alpha.6 第一次测试  //  by 青色漫地_wait" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                   Foreground="White" FontSize="12" Opacity="0.8"/>
    </Grid>

</Window>