<Window x:Class="ReTime_Testing.Views.TimeTopDesktop.TimeTopDesktop"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:timetop="clr-namespace:ReTime_Testing.Views.TimeTopDesktop"
        xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:vm="clr-namespace:ReTime_Testing.ViewModels"
        xmlns:helpers="clr-namespace:ReTime_Testing.Helpers"
        mc:Ignorable="d"
        Title="TimeTopDesktop">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <helpers:BooleanToEffectConverter x:Key="BooleanToEffectConverter"/>
    </Window.Resources>

    <Grid>
        <ui:ProgressBar x:Name="ProgressBar" VerticalAlignment="Top" MinHeight="3" Margin="0,0,0,0"
                       Value="{Binding ProgressValue}"
                       IsIndeterminate="{Binding IsIndeterminate}"
                       Foreground="{Binding Foreground, FallbackValue=Transparent}"
                       Background="{Binding Background, FallbackValue=Transparent}"
                       Visibility="{Binding Visibility}"
                       IsEnabled="{Binding IsEnabled}"
                       Opacity="{Binding Opacity}"
                       Minimum="{Binding Minimum}"
                       Maximum="{Binding Maximum}">
            <ui:ProgressBar.LayoutTransform>
                <ScaleTransform ScaleY="{Binding ProgressBarScale}"/>
            </ui:ProgressBar.LayoutTransform>
            <ui:ProgressBar.Effect>
                <Binding Path="EnableShadow" Converter="{StaticResource BooleanToEffectConverter}">
                    <Binding.ConverterParameter>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="8" Color="Black" Opacity="0.3"/>
                    </Binding.ConverterParameter>
                </Binding>
            </ui:ProgressBar.Effect>
        </ui:ProgressBar>

        <!-- 文字覆盖条（自定义面板：优先级 Left > Right > Center，重叠项消失） -->
        <timetop:PriorityTextOverlayPanel
              VerticalAlignment="Top"
              Margin="0,7,0,0"
              Height="18"
              Visibility="{Binding TextOverlay.IsVisible, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"
              LeftSlots="{Binding TextOverlay.LeftSlots}"
              CenterSlots="{Binding TextOverlay.CenterSlots}"
              RightSlots="{Binding TextOverlay.RightSlots}"
              StyleConfig="{Binding TextOverlay.Style}"/>
    </Grid>

</Window>